static float SMon_Batt_AbsF(float x)
{
	return (x < 0.0f) ? (-x) : x;
}

static float SMon_Batt_ClampF(float x, float lo, float hi)
{
	if (x < lo)
	{
		return lo;
	}
	else if (x > hi)
	{
		return hi;
	}
	else
	{
		return x;
	}
}

static uint16_t SMon_GetT30_mV(void)
{
	if (SMon_Filt_T30_mV <= 0.0f)
	{
		return 0u;
	}
	if (SMon_Filt_T30_mV >= 65535.0f)
	{
		return 65535u;
	}
	return (uint16_t)(SMon_Filt_T30_mV + 0.5f);
}

static uint16_t SMon_GetL1_mV(void)
{
	if (SMon_Filt_L1_mV <= 0.0f)
	{
		return 0u;
	}
	if (SMon_Filt_L1_mV >= 65535.0f)
	{
		return 65535u;
	}
	return (uint16_t)(SMon_Filt_L1_mV + 0.5f);
}

static float SMon_GetISense_A(void)
{
	float x = SMon_Filt_ISense_A;

	if ((x < SMon_P_CurrentNoiseDeadband_A) && (x > -SMon_P_CurrentNoiseDeadband_A))
	{
		x = 0.0f;
	}

	return x;
}

static float SMon_GetISenseAbsForStats_A(void)
{
	return SMon_Batt_AbsF(SMon_Filt_ISense_A);
}

static float SMon_GetExtChISense_A(void)
{
	float x = SMon_Filt_ExtChISense_A;

	if ((x < 0.20f) && (x > -0.20f))
	{
		x = 0.0f;
	}

	return x;
}

static float SMon_GetNtcTemp_C(void)
{
	return SMon_Filt_Ntc_C;
}

static void SMon_UpdateFilteredSignals(void)
{
	const float raw_t30 = (float)SMon_VfbT30;
	const float raw_l1 = (float)SMon_VfbL1;
	const float raw_i = SMon_ISenseL1_Float;
	const float raw_ext_i = SMon_ISenseL1_ExtChISense;
	const float raw_ntc = SMon_NTC_Temperature_L1;
	float abs_i;

	if (SMon_Filt_Init == 0u)
	{
		SMon_Filt_T30_mV = raw_t30;
		SMon_Filt_L1_mV = raw_l1;
		SMon_Filt_ISense_A = raw_i;
		SMon_Filt_ExtChISense_A = raw_ext_i;
		SMon_Filt_Ntc_C = raw_ntc;
		SMon_Filt_Init = 1u;
	}
	else
	{
		SMon_Filt_T30_mV += SMon_P_FilterAlphaVoltFast * (raw_t30 - SMon_Filt_T30_mV);
		SMon_Filt_L1_mV += SMon_P_FilterAlphaVoltFast * (raw_l1 - SMon_Filt_L1_mV);
		SMon_Filt_ISense_A += SMon_P_FilterAlphaCurrent * (raw_i - SMon_Filt_ISense_A);
		SMon_Filt_ExtChISense_A += SMon_P_FilterAlphaExtChCurrent * (raw_ext_i - SMon_Filt_ExtChISense_A);
		SMon_Filt_Ntc_C += SMon_P_FilterAlphaNtc * (raw_ntc - SMon_Filt_Ntc_C);
	}

	abs_i = SMon_Batt_AbsF(SMon_Filt_ISense_A);

	if (abs_i > SMon_PeakCurrent)
	{
		SMon_PeakCurrent = abs_i;
	}
	else
	{
		SMon_PeakCurrent += SMon_P_CurrentPeakAlpha * (abs_i - SMon_PeakCurrent);
	}
}

/* 12 V lead-acid OCV table at ~25 C, rested battery only.
 * Approximation only. */
static float SMon_Batt_OcvToSoc(float ocv_v)
{
	static const float ocv_tbl[11] =
	{
		11.80f, 11.95f, 12.06f, 12.15f, 12.24f,
		12.32f, 12.40f, 12.48f, 12.56f, 12.64f, 12.73f
	};

	static const float soc_tbl[11] =
	{
		0.0f, 10.0f, 20.0f, 30.0f, 40.0f,
		50.0f, 60.0f, 70.0f, 80.0f, 90.0f, 100.0f
	};

	uint32_t i;

	if (ocv_v <= ocv_tbl[0u])
	{
		return soc_tbl[0u];
	}

	if (ocv_v >= ocv_tbl[10u])
	{
		return soc_tbl[10u];
	}

	for (i = 0u; i < 10u; i++)
	{
		if ((ocv_v >= ocv_tbl[i]) && (ocv_v < ocv_tbl[i + 1u]))
		{
			const float x0 = ocv_tbl[i];
			const float x1 = ocv_tbl[i + 1u];
			const float y0 = soc_tbl[i];
			const float y1 = soc_tbl[i + 1u];
			const float ratio = (ocv_v - x0) / (x1 - x0);
			return y0 + (ratio * (y1 - y0));
		}
	}

	return 0.0f;
}

static float SMon_Batt_RintToSoh(float rint_ohm)
{
	float soh;

	if (rint_ohm <= SMon_P_BattNominalRint_Ohm)
	{
		soh = 100.0f;
	}
	else if (rint_ohm >= SMon_P_BattBadRint_Ohm)
	{
		soh = SMon_P_BattSoHMin_pct;
	}
	else
	{
		soh = 100.0f -
				((rint_ohm - SMon_P_BattNominalRint_Ohm) *
				(100.0f - SMon_P_BattSoHMin_pct) /
				(SMon_P_BattBadRint_Ohm - SMon_P_BattNominalRint_Ohm));
	}

	return SMon_Batt_ClampF(soh, SMon_P_BattSoHMin_pct, SMon_P_BattSoHMax_pct);
}

static void SMon_I2TAccumulation(void)
{
	static float I2TCounter_Float = 0.0f;
	static float ISenseL1_Average_Float = 0.0f;
	static float ISenseL1_Avged_Float = 0.0f;
	static float DeltaAmper_Float = 0.0f;
	static uint8_t localI2tAvgCounter = 0u;
	float i_filt;

	i_filt = SMon_GetISenseAbsForStats_A();

	if (1u == SMon_CmdStat)
	{
		if (SMon_P_I2TDebounceTime > localI2tAvgCounter)
		{
			localI2tAvgCounter++;
			ISenseL1_Average_Float += i_filt;
		}
		else
		{
			if (localI2tAvgCounter > 0u)
			{
				ISenseL1_Avged_Float = ISenseL1_Average_Float / (float)localI2tAvgCounter;
			}
			else
			{
				ISenseL1_Avged_Float = 0.0f;
			}

			localI2tAvgCounter = 0u;
			ISenseL1_Average_Float = 0.0f;
		}
	}

	if ((SMon_P_ISenseNominal < ISenseL1_Avged_Float) && (0u == SMon_I2TError) && (1u == SMon_CmdStat))
	{
		DeltaAmper_Float = (ISenseL1_Avged_Float * ISenseL1_Avged_Float) -
		                   (SMon_P_ISenseNominal * SMon_P_ISenseNominal);
		I2TCounter_Float += DeltaAmper_Float;
		SMon_I2TCounter = (uint32_t)I2TCounter_Float;
	}
	else
	{
		if ((SMon_P_I2TDebounceTime != 0u) && ((SMon_MainCnt % SMon_P_I2TDebounceTime) == 0u))
		{
			I2TCounter_Float = (I2TCounter_Float * (float)SMon_P_I2TDecrementPercentFactor) / 100.0f;
			SMon_I2TCounter = (uint32_t)I2TCounter_Float;

			if (I2TCounter_Float < 1.0f)
			{
				I2TCounter_Float = 0.0f;
				SMon_I2TCounter = 0u;
			}
		}
	}

	if (I2TCounter_Float > SMon_P_I2TRating)
	{
		SMon_I2TError = 1u;
		Dem_SetDtc(0x53u, 0x2fu);
		Dem_SetDtc_Obd(0x0153u, 0xafu);
	}
	else if ((0.0f == I2TCounter_Float) && (1u == SMon_I2TError))
	{
		SMon_I2TError = 0u;
	}
	else
	{
		if (0x2fu == Dem_GetDtcStatus(0x53u))
		{
			Dem_SetDtc(0x53u, 0x2eu);
			Dem_SetDtc_Obd(0x0153u, 0xaeu);
		}
	}
}

static void SMon_BatteryData(void)
{
	static uint8_t initialized = 0u;
	static float prev_v_filt = 0.0f;
	static float prev_i_filt = 0.0f;
	static float last_rest_reference_v = 0.0f;
	static uint32_t rest_start_ts = 0u;
	static float sum_charge_current = 0.0f;
	static float sum_discharge_current = 0.0f;
	static uint32_t cnt_charge = 0u;
	static uint32_t cnt_discharge = 0u;
	static float i_filt_state = 0.0f;
	static float offset_acc = 0.0f;
	static uint32_t offset_cnt = 0u;
	float v_meas = 0.0f;
	float i_raw = 0.0f;
	float i_est = 0.0f;
	float dt_h = 0.0f;
	float dv = 0.0f;
	float di = 0.0f;
	float abs_i = 0.0f;
	float soc_ocv_now = 0.0f;
	float current_abs_for_state = 0.0f;
	float charge_a = 0.0f;
	float discharge_a = 0.0f;

	dt_h = 0.005f / 3600.0f;
	v_meas = ((float)SMon_GetT30_mV()) / 1000.0f;
	i_raw = SMon_Filt_ISense_A;

	if (initialized == 0u)
	{
		i_filt_state = i_raw;
	}
	else
	{
		i_filt_state = (SMon_P_BattCurrentAlpha * i_filt_state) + ((1.0f - SMon_P_BattCurrentAlpha) * i_raw);
	}

	if ((SMon_Battery.Charging == 0u) &&
	    (SMon_Battery.Discharging == 0u) &&
	    (SMon_Battery.Voltage_V > 12.0f))
	{
		offset_acc += i_filt_state;
		offset_cnt++;

		if (offset_cnt >= 1000u)
		{
			SMon_P_ISenseZeroOffset_A = offset_acc / (float)offset_cnt;
			offset_acc = 0.0f;
			offset_cnt = 0u;
		}
	}
	else
	{
		offset_acc = 0.0f;
		offset_cnt = 0u;
	}

	i_est = i_filt_state - SMon_P_ISenseZeroOffset_A;

	if ((i_est < SMon_P_BattCurrentDeadband_A) && (i_est > -SMon_P_BattCurrentDeadband_A))
	{
		i_est = 0.0f;
	}

	if (initialized == 0u)
	{
		initialized = 1u;
		SMon_Battery.Voltage_V              = v_meas;
		SMon_Battery.VoltageFilt_V          = v_meas;
		SMon_Battery.Current_A              = i_raw;
		SMon_Battery.CurrentFilt_A          = i_est;
		SMon_Battery.Power_W                = v_meas * i_est;
		SMon_Battery.Charge_Ah_Acc          = 0.0f;
		SMon_Battery.Discharge_Ah_Acc       = 0.0f;
		SMon_Battery.Charge_Wh_Acc          = 0.0f;
		SMon_Battery.Discharge_Wh_Acc       = 0.0f;
		SMon_Battery.SoC_Coulomb_pct        = SMon_P_BattInitialSoC_pct;
		SMon_Battery.SoC_OCV_pct            = SMon_Batt_OcvToSoc(v_meas);
		SMon_Battery.SoC_Hybrid_pct         = SMon_P_BattInitialSoC_pct;
		SMon_Battery.SoH_pct                = 100.0f;
		SMon_Battery.AvailableCapacity_Ah   = SMon_P_BattNominalCapacity_Ah;
		SMon_Battery.NominalCapacity_Ah     = SMon_P_BattNominalCapacity_Ah;
		SMon_Battery.InternalResistance_Ohm = SMon_P_BattNominalRint_Ohm;
		SMon_Battery.AvgChargeCurrent_A     = 0.0f;
		SMon_Battery.AvgDischargeCurrent_A  = 0.0f;
		SMon_Battery.RuntimeRemaining_h     = 0.0f;
		SMon_Battery.TimeToFull_h           = 0.0f;
		SMon_Battery.BatteryRested          = 0u;
		SMon_Battery.Charging               = 0u;
		SMon_Battery.Discharging            = 0u;
		SMon_Battery.WeakBattery            = 0u;
		SMon_Battery.DeepDischarge          = 0u;
		SMon_Battery.CrankingEvent          = 0u;
		SMon_Battery.ValidOcvCalibration    = 0u;
		SMon_Battery.Confidence_pct         = 50u;
		prev_v_filt = v_meas;
		prev_i_filt = i_est;
		last_rest_reference_v = v_meas;
	}

	SMon_Battery.Voltage_V = v_meas;
	SMon_Battery.Current_A = i_raw;
	SMon_Battery.VoltageFilt_V += SMon_P_BattAlphaVolt * (v_meas - SMon_Battery.VoltageFilt_V);
	SMon_Battery.CurrentFilt_A = i_est;
	SMon_Battery.Power_W = SMon_Battery.VoltageFilt_V * SMon_Battery.CurrentFilt_A;

	if (SMon_Battery.CurrentFilt_A <= -SMon_P_BattCurrentDeadband_A)
	{
		SMon_Battery.Charging = 1u;
		SMon_Battery.Discharging = 0u;
		charge_a = -SMon_Battery.CurrentFilt_A;
		SMon_Battery.Charge_Ah_Acc += charge_a * dt_h;
		SMon_Battery.Charge_Wh_Acc += (SMon_Battery.VoltageFilt_V * charge_a) * dt_h;
		sum_charge_current += charge_a;
		cnt_charge++;
	}
	else if (SMon_Battery.CurrentFilt_A >= SMon_P_BattCurrentDeadband_A)
	{
		SMon_Battery.Charging = 0u;
		SMon_Battery.Discharging = 1u;
		discharge_a = SMon_Battery.CurrentFilt_A;
		SMon_Battery.Discharge_Ah_Acc += discharge_a * dt_h;
		SMon_Battery.Discharge_Wh_Acc += (SMon_Battery.VoltageFilt_V * discharge_a) * dt_h;
		sum_discharge_current += discharge_a;
		cnt_discharge++;
	}
	else
	{
		SMon_Battery.Charging = 0u;
		SMon_Battery.Discharging = 0u;
	}

	if (cnt_charge > 0u)
	{
		SMon_Battery.AvgChargeCurrent_A = sum_charge_current / (float)cnt_charge;
	}
	else
	{
		SMon_Battery.AvgChargeCurrent_A = 0.0f;
	}

	if (cnt_discharge > 0u)
	{
		SMon_Battery.AvgDischargeCurrent_A = sum_discharge_current / (float)cnt_discharge;
	}
	else
	{
		SMon_Battery.AvgDischargeCurrent_A = 0.0f;
	}

	if (SMon_Battery.CurrentFilt_A >= SMon_P_BattCurrentDeadband_A)
	{
		SMon_Battery.SoC_Coulomb_pct -=
			(SMon_Battery.CurrentFilt_A * dt_h * 100.0f) / SMon_Battery.AvailableCapacity_Ah;
	}
	else if (SMon_Battery.CurrentFilt_A <= -SMon_P_BattCurrentDeadband_A)
	{
		charge_a = -SMon_Battery.CurrentFilt_A;
		SMon_Battery.SoC_Coulomb_pct +=
			((charge_a * SMon_P_BattChargeEfficiency) * dt_h * 100.0f) /
			SMon_Battery.AvailableCapacity_Ah;
	}

	SMon_Battery.SoC_Coulomb_pct =
		SMon_Batt_ClampF(SMon_Battery.SoC_Coulomb_pct,
		                 SMon_P_BattMinSoC_pct,
		                 SMon_P_BattMaxSoC_pct);

	abs_i = SMon_Batt_AbsF(SMon_Battery.CurrentFilt_A);

	if ((abs_i <= SMon_P_BattRestCurrent_A) &&
	    (SMon_Batt_AbsF(SMon_Battery.VoltageFilt_V - last_rest_reference_v) <= SMon_P_BattRestVoltDelta_V))
	{
		if (rest_start_ts == 0u)
		{
			rest_start_ts = SMon_MainCnt;
			last_rest_reference_v = SMon_Battery.VoltageFilt_V;
			SMon_Battery.BatteryRested = 0u;
		}
		else
		{
			if ((SMon_MainCnt - rest_start_ts) >= SMon_P_BattRestTimeTicks)
			{
				SMon_Battery.BatteryRested = 1u;
			}
			else
			{
				SMon_Battery.BatteryRested = 0u;
			}
		}
	}
	else
	{
		rest_start_ts = 0u;
		last_rest_reference_v = SMon_Battery.VoltageFilt_V;
		SMon_Battery.BatteryRested = 0u;
	}

	soc_ocv_now = SMon_Batt_OcvToSoc(SMon_Battery.VoltageFilt_V);
	SMon_Battery.SoC_OCV_pct = soc_ocv_now;

	if (SMon_Battery.BatteryRested == 1u)
	{
		SMon_Battery.SoC_Coulomb_pct +=
			SMon_P_BattOcvCorrectionGain *
			(soc_ocv_now - SMon_Battery.SoC_Coulomb_pct);

		SMon_Battery.SoC_Coulomb_pct =
			SMon_Batt_ClampF(SMon_Battery.SoC_Coulomb_pct,
			                 SMon_P_BattMinSoC_pct,
			                 SMon_P_BattMaxSoC_pct);

		SMon_Battery.ValidOcvCalibration = 1u;
	}

	SMon_Battery.SoC_Hybrid_pct = SMon_Battery.SoC_Coulomb_pct;

	dv = prev_v_filt - SMon_Battery.VoltageFilt_V;
	di = SMon_Battery.CurrentFilt_A - prev_i_filt;

	if ((SMon_Batt_AbsF(di) > 2.0f) && (SMon_Batt_AbsF(dv) > 0.03f))
	{
		const float r_inst = SMon_Batt_AbsF(dv / di);

		if ((r_inst > 0.001f) && (r_inst < 0.300f))
		{
			SMon_Battery.InternalResistance_Ohm +=
				SMon_P_BattAlphaRint * (r_inst - SMon_Battery.InternalResistance_Ohm);
		}
	}

	prev_v_filt = SMon_Battery.VoltageFilt_V;
	prev_i_filt = SMon_Battery.CurrentFilt_A;

	SMon_Battery.SoH_pct = SMon_Batt_RintToSoh(SMon_Battery.InternalResistance_Ohm);

	SMon_Battery.AvailableCapacity_Ah =
		SMon_P_BattNominalCapacity_Ah * (SMon_Battery.SoH_pct / 100.0f);

	if (SMon_Battery.AvailableCapacity_Ah < 1.0f)
	{
		SMon_Battery.AvailableCapacity_Ah = 1.0f;
	}

	if (SMon_Battery.CurrentFilt_A >= SMon_P_BattCurrentDeadband_A)
	{
		SMon_Battery.RuntimeRemaining_h =
			((SMon_Battery.SoC_Hybrid_pct / 100.0f) * SMon_Battery.AvailableCapacity_Ah) /
			SMon_Battery.CurrentFilt_A;
	}
	else
	{
		SMon_Battery.RuntimeRemaining_h = 0.0f;
	}

	if (SMon_Battery.CurrentFilt_A <= -SMon_P_BattCurrentDeadband_A)
	{
		charge_a = -SMon_Battery.CurrentFilt_A;

		SMon_Battery.TimeToFull_h =
			(((100.0f - SMon_Battery.SoC_Hybrid_pct) / 100.0f) * SMon_Battery.AvailableCapacity_Ah) /
			(charge_a * SMon_P_BattChargeEfficiency);
	}
	else
	{
		SMon_Battery.TimeToFull_h = 0.0f;
	}

	SMon_Battery.WeakBattery =
		((SMon_Battery.VoltageFilt_V <= SMon_P_BattWeakVolt_V) ||
		 (SMon_Battery.SoC_Hybrid_pct <= 20.0f) ||
		 (SMon_Battery.InternalResistance_Ohm >= (0.75f * SMon_P_BattBadRint_Ohm))) ? 1u : 0u;

	SMon_Battery.DeepDischarge =
		((SMon_Battery.VoltageFilt_V <= SMon_P_BattDeepDischargeVolt_V) ||
		 (SMon_Battery.SoC_Hybrid_pct <= 10.0f)) ? 1u : 0u;

	current_abs_for_state = SMon_Batt_AbsF(SMon_Battery.CurrentFilt_A);

	SMon_Battery.CrankingEvent =
		((SMon_Battery.Voltage_V <= SMon_P_BattCrankVolt_V) &&
		 (current_abs_for_state > 5.0f)) ? 1u : 0u;

	{
		float conf = 40.0f;

		if (SMon_Battery.ValidOcvCalibration == 1u)
		{
			conf += 25.0f;
		}

		if (SMon_Battery.BatteryRested == 1u)
		{
			conf += 10.0f;
		}

		if (SMon_Battery.InternalResistance_Ohm <= SMon_P_BattNominalRint_Ohm)
		{
			conf += 15.0f;
		}
		else if (SMon_Battery.InternalResistance_Ohm >= SMon_P_BattBadRint_Ohm)
		{
			conf -= 10.0f;
		}

		if (SMon_Battery.CrankingEvent == 1u)
		{
			conf -= 5.0f;
		}

		SMon_Battery.Confidence_pct = (uint8_t)SMon_Batt_ClampF(conf, 0.0f, 90.0f);
	}
}

static void SMon_ProcessShortToPlusTest(void)
{
	static uint32_t localDischargeTimer = 0u;
	static uint32_t localLowDisTimer = 0u;
	static uint32_t localS2BCounter = 0u;
	uint16_t vfb_l1;
	uint16_t vfb_t30;

	vfb_l1 = SMon_GetL1_mV();
	vfb_t30 = SMon_GetT30_mV();

	if (1u != SMon_RequestPhysicalStatus)
	{
		if (0u == SMon_ShortToPlusTest)
		{
			SMon_ShortToPlusTest = 1u;
		}
	}
	else
	{
		SMon_ShortToPlusTest = 0u;
		localDischargeTimer = 0u;
		localLowDisTimer = 0u;
		localS2BCounter = 0u;
		SMon_S2BErrorStatus = 0u;
	}

	if (0u != SMon_ShortToPlusTest)
	{
		if (0u == localDischargeTimer)
		{
			localDischargeTimer = SMon_MainCnt;
			localLowDisTimer = SMon_MainCnt;
			localS2BCounter = SMon_MainCnt;
		}
		else
		{
			switch (SMon_ShortToPlusTest)
			{
			case 1u:
				if (SMon_P_DischargeTimeCycles <= (SMon_MainCnt - localDischargeTimer))
				{
					if (SMon_T30P50 <= vfb_l1)
					{
						Dem_SetDtc(0x52u, 0x2fu);
						Dem_SetDtc_Obd(0x0152u, 0xafu);
						SMon_ShortToPlusTest = 2u;
						SMon_S2BErrorStatus = 1u;
					}
				}
				else
				{
					if (SMon_T30P50 > vfb_l1)
					{
						SMon_ShortToPlusTest = 2u;
						SMon_S2BErrorStatus = 0u;

						if (0x2fu == Dem_GetDtcStatus(0x52u))
						{
							Dem_SetDtc(0x52u, 0x2eu);
							Dem_SetDtc_Obd(0x0152u, 0xaeu);
						}
					}
				}
				break;

			case 2u:
				if (SMon_P_LowDisTimeCyc <= (SMon_MainCnt - localLowDisTimer))
				{
					if ((uint32_t)((vfb_t30 * 3u) / 10u) <= (uint32_t)vfb_l1)
					{
						Dem_SetDtc(0x5fu, 0x2fu);
						Dem_SetDtc_Obd(0x0152u, 0xafu);
						SMon_ShortToPlusTest = 3u;
						SMon_S2BErrorStatus = 2u;
					}
				}
				else
				{
					if ((uint32_t)((vfb_t30 * 3u) / 10u) > (uint32_t)vfb_l1)
					{
						SMon_ShortToPlusTest = 3u;
						SMon_S2BErrorStatus = 0u;

						if (0x2fu == Dem_GetDtcStatus(0x5fu))
						{
							Dem_SetDtc(0x5fu, 0x2eu);
							Dem_SetDtc_Obd(0x0152u, 0xaeu);
						}
					}
				}
				break;

			case 3u:
				if (SMon_P_LongDischargeTimeCycles <= (SMon_MainCnt - localS2BCounter))
				{
					if (SMon_P_LowVoltage <= vfb_l1)
					{
						Dem_SetDtc(0x60u, 0x2fu);
						Dem_SetDtc_Obd(0x0152u, 0xafu);
						SMon_S2BErrorStatus = 3u;
						SMon_ShortToPlusTest = 4u;
					}
				}
				else
				{
					if (SMon_P_LowVoltage > vfb_l1)
					{
						SMon_ShortToPlusTest = 4u;
						SMon_S2BErrorStatus = 0u;

						if (0x2fu == Dem_GetDtcStatus(0x60u))
						{
							Dem_SetDtc(0x60u, 0x2eu);
							Dem_SetDtc_Obd(0x0152u, 0xaeu);
						}
					}
				}
				break;

			default:
				break;
			}
		}
	}
}

static void SMon_ProcessLoadCurrentState(void)
{
	static uint8_t pSMon_CalculatedCommand = 0u;
	static uint8_t inhibitReactivation = 0u;
	uint8_t calculatedCommand;
	uint8_t anyFaultActive;
	uint8_t risingEdgeCmd;
	uint32_t thresh_on;
	uint32_t thresh_off;
	uint16_t vfb_t30;
	uint16_t vfb_l1;

	vfb_t30 = SMon_GetT30_mV();
	vfb_l1 = SMon_GetL1_mV();

	SMon_T30P50 = (uint16_t)((vfb_t30 * 5u) / 10u);
	thresh_on  = (uint32_t)SMon_T30P50 + SMon_P_StatusVoltageL1Filter;
	thresh_off = (SMon_T30P50 > SMon_P_StatusVoltageL1Filter) ? ((uint32_t)SMon_T30P50 - SMon_P_StatusVoltageL1Filter) : 0u;

	if ((SMon_L1ST == 0u) && ((uint32_t)vfb_l1 >= thresh_on))
	{
		SMon_L1ST = 1u;
	}
	else if ((SMon_L1ST == 1u) && ((uint32_t)vfb_l1 <= thresh_off))
	{
		SMon_L1ST = 0u;
	}

	if (Dcm_LoadStatus == 1u)
	{
		calculatedCommand = 1u;
	}
	else if (Dcm_LoadStatus == 0u)
	{
		calculatedCommand = 0u;
	}
	else if (SMon_CmdStat == 1u)
	{
		calculatedCommand = 1u;
	}
	else if (SMon_CmdStat == 0u)
	{
		calculatedCommand = 0u;
	}
	else if (EcuM_WUPLine == 1u)
	{
		calculatedCommand = 1u;
	}
	else if (SMon_ExternalChargerDetected == 1u)
	{
		calculatedCommand = 1u;
	}
	else
	{
		calculatedCommand = 0u;
	}

	SMon_CalculatedCommand = calculatedCommand;

	anyFaultActive =
		(SMon_CLS_Failure != 0u) ||
		(SMon_L1_UVStatus  != 0u) ||
		(SMon_NtcError     != 0u) ||
		(SMon_ECU_OV       != 0u) ||
		(SMon_ECU_UV       != 0u);

	if ((SMon_L1_UVStatus == 1u) ||
	    (SMon_ECU_OV      == 1u) ||
	    (SMon_ECU_UV      == 1u))
	{
		inhibitReactivation = 1u;
	}

	risingEdgeCmd =
		(pSMon_CalculatedCommand == 0u) &&
		(SMon_CalculatedCommand  == 1u);

	if (risingEdgeCmd != 0u)
	{
		inhibitReactivation = 0u;
	}

	if ((SMon_CalculatedCommand == 1u) &&
	    (anyFaultActive == 0u) &&
	    (inhibitReactivation == 0u))
	{
		SMon_RequestPhysicalStatus = 1u;
	}
	else
	{
		SMon_RequestPhysicalStatus = 0u;
	}

	pSMon_CalculatedCommand = SMon_CalculatedCommand;
}

static void SMon_ProcessEcuVoltageState(void)
{
	static uint32_t CounterUVKL30 = 0u;
	static uint32_t CounterOVKL30 = 0u;
	uint16_t vfb_t30;

	vfb_t30 = SMon_GetT30_mV();

	if ((SMon_P_UV_KL30 <= vfb_t30) && (SMon_P_OV_KL30 >= vfb_t30))
	{
		CounterUVKL30 = 0u;
		CounterOVKL30 = 0u;
		SMon_ECU_UV = 0u;
		SMon_ECU_OV = 0u;
	}
	else
	{
		if (SMon_P_UV_KL30 > vfb_t30)
		{
			if (0u == CounterUVKL30)
			{
				CounterUVKL30 = SMon_MainCnt;
			}
			else
			{
				if (SMon_P_WaitTimeOVUV < (SMon_MainCnt - CounterUVKL30))
				{
					SMon_ECU_UV = 1u;
					Dem_SetDtc(0x50u, 0x2fu);
					Dem_SetDtc_Obd(0x0150u, 0xafu);
				}
				else
				{
					SMon_ECU_UV = 0u;

					if (0x2fu == Dem_GetDtcStatus(0x50u))
					{
						Dem_SetDtc(0x50u, 0x2eu);
						Dem_SetDtc_Obd(0x0150u, 0xaeu);
					}
				}
			}
		}
		else
		{
			CounterUVKL30 = 0u;
		}

		if (SMon_P_OV_KL30 < vfb_t30)
		{
			if (0u == CounterOVKL30)
			{
				CounterOVKL30 = SMon_MainCnt;
			}
			else
			{
				if (SMon_P_WaitTimeOVUV < (SMon_MainCnt - CounterOVKL30))
				{
					SMon_ECU_OV = 1u;
					Dem_SetDtc(0x51u, 0x2fu);
					Dem_SetDtc_Obd(0x0151u, 0xafu);
				}
				else
				{
					SMon_ECU_OV = 0u;

					if (0x2fu == Dem_GetDtcStatus(0x51u))
					{
						Dem_SetDtc(0x51u, 0x2eu);
						Dem_SetDtc_Obd(0x0151u, 0xaeu);
					}
				}
			}
		}
		else
		{
			CounterOVKL30 = 0u;
		}
	}
}

static void SMon_ProcessLoadErrorStatus(void)
{
	static uint8_t pSMon_I2TError = 0u;
	static uint8_t pSMon_CLS_Failure = 0u;
	static uint8_t pSMon_CmdStat = 0u;
	static uint32_t localTimeStamp = 0u;
	static uint32_t localTimeStamp2 = 0u;
	static uint32_t localTimeStamp3 = 0u;
	static uint8_t pCanH_VehicleStatus = 0u;
	static uint32_t l1_uv_recovery_ts = 0u;
	float ntc_temp;
	float ext_i;
	uint16_t vfb_l1;

	ntc_temp = SMon_GetNtcTemp_C();
	ext_i = SMon_GetExtChISense_A();
	vfb_l1 = SMon_GetL1_mV();

	if (1u == SMon_LockSupply)
	{
		if ((((1u == pCanH_VehicleStatus) || (2u == pCanH_VehicleStatus) || (3u == pCanH_VehicleStatus))) &&
		    (((4u == CanH_VehicleStatus) || (6u == CanH_VehicleStatus))))
		{
			SMon_LockSupply = 0u;
			SMon_RetryCnt = 0u;
		}
	}

	if (pCanH_VehicleStatus != CanH_VehicleStatus)
	{
		pCanH_VehicleStatus = CanH_VehicleStatus;
	}

	if (SMon_P_NTCTemperatureMax < ntc_temp)
	{
		if (0u == localTimeStamp3)
		{
			localTimeStamp3 = SMon_MainCnt;
		}
		else
		{
			if (SMon_P_WaitTimeOVUV < (SMon_MainCnt - localTimeStamp3))
			{
				SMon_RequestPhysicalStatus = 0u;
				SMon_NtcError = 1u;
				Dem_SetDtc(0x58u, 0x2fu);
				Dem_SetDtc_Obd(0x0158u, 0xafu);
				localTimeStamp3 = 0u;
			}
		}
	}
	else if (SMon_P_NTCTemperatureRelease > ntc_temp)
	{
		if (SMon_P_WaitTimeOVUV < (SMon_MainCnt - localTimeStamp3))
		{
			SMon_NtcError = 0u;

			if (0x2fu == Dem_GetDtcStatus(0x58u))
			{
				Dem_SetDtc(0x58u, 0x2eu);
			}

			localTimeStamp3 = 0u;
		}
	}

	if (SMon_P_ExternalChargerThreshold > ext_i)
	{
		if (0u == localTimeStamp2)
		{
			localTimeStamp2 = SMon_MainCnt;
		}
		else
		{
			if (SMon_P_WaitTimeOVUV < (SMon_MainCnt - localTimeStamp2))
			{
				SMon_ExternalChargerDetected = 1u;
				SMon_RequestPhysicalStatus = 1u;
				Dem_SetDtc(0x59u, 0x2fu);
				localTimeStamp2 = 0u;
			}
		}
	}
	else if (ext_i > -0.1f)
	{
		if (0u == localTimeStamp2)
		{
			localTimeStamp2 = SMon_MainCnt;
		}
		else
		{
			if (SMon_P_WaitTimeOVUV < (SMon_MainCnt - localTimeStamp2))
			{
				SMon_ExternalChargerDetected = 0u;

				if (0x2fu == Dem_GetDtcStatus(0x59u))
				{
					Dem_SetDtc(0x59u, 0x2eu);
				}

				localTimeStamp2 = 0u;
			}
		}
	}

	if (1u == SMon_CLS_Failure)
	{
		if (0u == localTimeStamp)
		{
			localTimeStamp = SMon_MainCnt;
		}
		else
		{
			if (SMon_P_ClsFailureWaitTime < (SMon_MainCnt - localTimeStamp))
			{
				SMon_CLS_Failure = 0u;
				localTimeStamp = 0u;
			}
		}
	}

	if ((1u == SMon_ECU_OV) || (1u == SMon_ECU_UV))
	{
		SMon_RequestPhysicalStatus = 0u;
	}

	if (1u == SMon_I2TError)
	{
		SMon_RequestPhysicalStatus = 0u;
	}

	if ((1u == pSMon_CLS_Failure) && (0u == SMon_CLS_Failure) && (0u == SMon_LockSupply))
	{
		pSMon_CLS_Failure = SMon_CLS_Failure;
		SMon_RetryCnt++;
	}

	if ((1u == pSMon_I2TError) && (0u == SMon_I2TError) && (0u == SMon_LockSupply))
	{
		pSMon_I2TError = SMon_I2TError;
		SMon_RetryCnt++;
	}

	if (SMon_P_Rtcntmax == SMon_RetryCnt)
	{
		SMon_LockSupply = 1u;
		Dem_SetDtc(0x54u, 0x2fu);
		Dem_SetDtc_Obd(0x0154u, 0xafu);
	}

	if (0u != SMon_LockSupply)
	{
		SMon_RequestPhysicalStatus = 0u;
	}

	if (SMon_L1_UVStatus == 1u)
	{
		SMon_RequestPhysicalStatus = 0u;

		if (vfb_l1 >= SMon_T30P50)
		{
			if (l1_uv_recovery_ts == 0u)
			{
				l1_uv_recovery_ts = SMon_MainCnt;
			}
			else
			{
				if (SMon_P_WaitTimeOVUV < (SMon_MainCnt - l1_uv_recovery_ts))
				{
					SMon_L1_UVStatus = 0u;
					SMon_CounterUVL1 = 0u;
					l1_uv_recovery_ts = 0u;

					if (0x2fu == Dem_GetDtcStatus(0x56u))
					{
						Dem_SetDtc(0x56u, 0x2eu);
						Dem_SetDtc_Obd(0x0156u, 0xaeu);
					}
				}
			}
		}
		else
		{
			l1_uv_recovery_ts = 0u;
		}
	}
	else
	{
		l1_uv_recovery_ts = 0u;
	}

	if (pSMon_CmdStat != SMon_CmdStat)
	{
		pSMon_CmdStat = SMon_CmdStat;
	}

	if (pSMon_I2TError != SMon_I2TError)
	{
		pSMon_I2TError = SMon_I2TError;
	}

	if (pSMon_CLS_Failure != SMon_CLS_Failure)
	{
		pSMon_CLS_Failure = SMon_CLS_Failure;
	}
}

static void SMon_LoadSwitchingDiagnosis(void)
{
	uint16_t vfb_l1;

	vfb_l1 = SMon_GetL1_mV();

	if (1u == SMon_CLSFlag)
	{
		if ((SMon_P_CLSTime >= 20u) && ((SMon_P_CLSTime - 20u) <= (SMon_MainCnt - SMon_CLSCheckVoltage_Timestamp)))
		{
			if (SMon_P_UV_CLS <= vfb_l1)
			{
				SMon_CLS_Failure = 0u;

				if (0x2fu == Dem_GetDtcStatus(0x55u))
				{
					Dem_SetDtc(0x55u, 0x2eu);
					Dem_SetDtc_Obd(0x0155u, 0xaeu);
				}
			}
			else
			{
				SMon_CLS_Failure = 1u;
				SMon_RequestPhysicalStatus = 0u;
				Dem_SetDtc(0x55u, 0x2fu);
				Dem_SetDtc_Obd(0x0155u, 0xafu);
			}
		}

		if ((SMon_P_CLSTime >= 14u) && ((SMon_P_CLSTime - 14u) <= (SMon_MainCnt - SMon_CLSCheckVoltage_Timestamp)))
		{
			if ((SMon_T30P50 >= 1000u) && ((SMon_T30P50 - 1000u) <= vfb_l1))
			{
				SMon_CLS_Failure = 0u;

				if (0x2fu == Dem_GetDtcStatus(0x55u))
				{
					Dem_SetDtc(0x55u, 0x2eu);
				}
			}
			else
			{
				SMon_CLS_Failure = 1u;
				SMon_RequestPhysicalStatus = 0u;
				Dem_SetDtc(0x55u, 0x2fu);
			}
		}
	}
	else if (2u == SMon_CLSFlag)
	{
		if (1u == SMon_SWState)
		{
			if (SMon_T30P50 <= vfb_l1)
			{
				SMon_L1_UVStatus = 0u;
				SMon_CounterUVL1 = 0u;
			}
			else
			{
				if (0u == SMon_CounterUVL1)
				{
					SMon_CounterUVL1 = SMon_MainCnt;
				}
				else
				{
					if (SMon_P_WaitTimeOVUV < (SMon_MainCnt - SMon_CounterUVL1))
					{
						SMon_L1_UVStatus = 1u;
						SMon_RequestPhysicalStatus = 0u;
						Dem_SetDtc(0x56u, 0x2fu);
						Dem_SetDtc_Obd(0x0156u, 0xafu);
					}
				}
			}
		}
	}
}

static void SMon_LoadSwitchingLogic(void)
{
	static uint8_t localCPCFlag = 0u;
	static uint32_t localCLSCounter = 0u;

	htim1.Instance->CCR1 = 514u;
	localCPCFlag = 2u;

	if (1u == SMon_RequestPhysicalStatus)
	{
		if (2u == localCPCFlag)
		{
			if (0u == SMon_CLSFlag)
			{
				if (0u == localCLSCounter)
				{
					localCLSCounter = SMon_MainCnt;
					SMon_CLSCheckVoltage_Timestamp = SMon_MainCnt;
					SMon_CLSFlag = 1u;
					HAL_GPIO_WritePin(ENL1CLS_GPIO_Port, ENL1CLS_Pin, GPIO_PIN_SET);
				}
			}
			else if (1u == SMon_CLSFlag)
			{
				if (SMon_P_CLSTime <= (SMon_MainCnt - localCLSCounter))
				{
					localCLSCounter = 0u;
					SMon_CLSFlag = 2u;
					HAL_GPIO_WritePin(ENL1CLS_GPIO_Port, ENL1CLS_Pin, GPIO_PIN_RESET);
				}
				else if ((SMon_P_CLSTime >= 1u) && ((SMon_P_CLSTime - 1u) <= (SMon_MainCnt - localCLSCounter)))
				{
					HAL_GPIO_WritePin(ENL1_GPIO_Port, ENL1_Pin, GPIO_PIN_SET);
				}
			}
		}
	}
	else
	{
		localCPCFlag = 0u;
		SMon_CLSFlag = 0u;
		SMon_CounterUVL1 = 0u;
		localCLSCounter = 0u;
		SMon_CLSCheckVoltage_Timestamp = 0u;
		HAL_GPIO_WritePin(ENL1CLS_GPIO_Port, ENL1CLS_Pin, GPIO_PIN_RESET);
		HAL_GPIO_WritePin(ENL1_GPIO_Port, ENL1_Pin, GPIO_PIN_RESET);
	}
}

static void SMon_CalculateMinMaxAvg(void)
{
	float t30;
	float l1;
	float l1i;

	t30 = (float)SMon_GetT30_mV();
	l1 = (float)SMon_GetL1_mV();
	l1i = SMon_GetISenseAbsForStats_A();

	if (SMon_Stats10s_Active == 0u)
	{
		SMon_Stats10s_Timer++;

		if (t30 < SMon_10s_T30_Min)
		{
			SMon_10s_T30_Min = t30;
		}

		if (t30 > SMon_10s_T30_Max)
		{
			SMon_10s_T30_Max = t30;
		}

		SMon_10s_T30_Sum += t30;

		if (l1 < SMon_10s_L1_Min)
		{
			SMon_10s_L1_Min = l1;
		}

		if (l1 > SMon_10s_L1_Max)
		{
			SMon_10s_L1_Max = l1;
		}

		SMon_10s_L1_Sum += l1;

		if (l1i < SMon_10s_L1I_Min)
		{
			SMon_10s_L1I_Min = l1i;
		}

		if (l1i > SMon_10s_L1I_Max)
		{
			SMon_10s_L1I_Max = l1i;
		}

		SMon_10s_L1I_Sum += l1i;
		SMon_10s_SampleCnt++;

		if (SMon_10s_SampleCnt > 0u)
		{
			SMon_10s_T30_Avg = SMon_10s_T30_Sum / (float)SMon_10s_SampleCnt;
			SMon_10s_L1_Avg  = SMon_10s_L1_Sum  / (float)SMon_10s_SampleCnt;
			SMon_10s_L1I_Avg = SMon_10s_L1I_Sum / (float)SMon_10s_SampleCnt;
		}

		if (SMon_Stats10s_Timer >= SMon_P_10sCycles)
		{
			SMon_Stats10s_Active = 1u;
		}
	}

	if (SMon_StatsSW_Active == 0u)
	{
		if ((SMon_MainCnt % 12001u == 0u) && (0u != SMon_MainCnt))
		{
			SMon_SW_T30_Min = 1e9f;
			SMon_SW_T30_Max = -1e9f;
			SMon_SW_L1_Min = 1e9f;
			SMon_SW_L1_Max = -1e9f;
			SMon_SW_L1I_Min = 1e9f;
			SMon_SW_L1I_Max = -1e9f;
			SMon_SW_T30_Sum = 0.0f;
			SMon_SW_L1_Sum = 0.0f;
			SMon_SW_L1I_Sum = 0.0f;
			SMon_SW_SampleCnt = 0u;
		}

		if (t30 < SMon_SW_T30_Min)
		{
			SMon_SW_T30_Min = t30;
		}

		if (t30 > SMon_SW_T30_Max)
		{
			SMon_SW_T30_Max = t30;
		}

		SMon_SW_T30_Sum += t30;

		if (l1 < SMon_SW_L1_Min)
		{
			SMon_SW_L1_Min = l1;
		}

		if (l1 > SMon_SW_L1_Max)
		{
			SMon_SW_L1_Max = l1;
		}

		SMon_SW_L1_Sum += l1;

		if (l1i < SMon_SW_L1I_Min)
		{
			SMon_SW_L1I_Min = l1i;
		}

		if (l1i > SMon_SW_L1I_Max)
		{
			SMon_SW_L1I_Max = l1i;
		}

		SMon_SW_L1I_Sum += l1i;
		SMon_SW_SampleCnt++;

		if (SMon_SW_SampleCnt > 0u)
		{
			SMon_SW_T30_Avg = SMon_SW_T30_Sum / (float)SMon_SW_SampleCnt;
			SMon_SW_L1_Avg = SMon_SW_L1_Sum / (float)SMon_SW_SampleCnt;
			SMon_SW_L1I_Avg = SMon_SW_L1I_Sum / (float)SMon_SW_SampleCnt;
		}
	}

	if (SMon_SWState >= 2u)
	{
		SMon_StatsSW_Active = 1u;
	}
	else
	{
		SMon_StatsSW_Active = 0u;
	}

	if ((SMon_MainCnt % 12000u == 0u) && (0u != SMon_MainCnt))
	{
		SMon_DataMinMaxAvg[0u] = SMon_10s_T30_Min;
		SMon_DataMinMaxAvg[1u] = SMon_10s_T30_Max;
		SMon_DataMinMaxAvg[2u] = SMon_10s_T30_Avg;
		SMon_DataMinMaxAvg[3u] = SMon_10s_L1_Min;
		SMon_DataMinMaxAvg[4u] = SMon_10s_L1_Max;
		SMon_DataMinMaxAvg[5u] = SMon_10s_L1_Avg;
		SMon_DataMinMaxAvg[6u] = SMon_10s_L1I_Min;
		SMon_DataMinMaxAvg[7u] = SMon_10s_L1I_Max;
		SMon_DataMinMaxAvg[8u] = SMon_10s_L1I_Avg;
		SMon_DataMinMaxAvg[9u] = SMon_SW_T30_Min;
		SMon_DataMinMaxAvg[10u] = SMon_SW_T30_Max;
		SMon_DataMinMaxAvg[11u] = SMon_SW_T30_Avg;
		SMon_DataMinMaxAvg[12u] = SMon_SW_L1_Min;
		SMon_DataMinMaxAvg[13u] = SMon_SW_L1_Max;
		SMon_DataMinMaxAvg[14u] = SMon_SW_L1_Avg;
		SMon_DataMinMaxAvg[15u] = SMon_SW_L1I_Min;
		SMon_DataMinMaxAvg[16u] = SMon_SW_L1I_Max;
		SMon_DataMinMaxAvg[17u] = SMon_SW_L1I_Avg;

		Nvm_WriteBlock(3u, &SMon_DataMinMaxAvg[0u]);
	}
}

static void SMon_LoadCurrentErrorState(void)
{
	SMon_ProcessLoadCurrentState();
	SMon_ProcessLoadErrorStatus();
	SMon_I2TAccumulation();
	SMon_ProcessShortToPlusTest();
}

static void SMon_LoadSwitchState(void)
{
	SMon_LoadSwitchingDiagnosis();
	SMon_LoadSwitchingLogic();
}

void SMon_main(void)
{
	SMon_UpdateFilteredSignals();
	SMon_ProcessEcuVoltageState();
	SMon_LoadCurrentErrorState();
	SMon_LoadSwitchState();
	SMon_BatteryData();

	if ((400u <= SMon_MainCnt) && (0u != SMon_MainCnt))
	{
		SMon_CalculateMinMaxAvg();
	}

	SMon_MainCnt++;
}
