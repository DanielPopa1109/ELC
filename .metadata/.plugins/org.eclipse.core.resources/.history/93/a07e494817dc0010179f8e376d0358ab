static ph_isorx_t r = {0};

static void ParamH_SendNrc(uint32_t reqid, uint8_t sid, uint8_t nrc)
{
	uint8_t p[3] = {0x7Fu, sid, nrc};
	(void)Dcm_IsoTp_Send(reqid, p, 3u, 0x00u, 1u);
}

static void ParamH_SendPos(uint32_t reqid, uint8_t ridLo)
{
	uint8_t p[5] = {0x71u, 0x01u, 0x01u, ridLo, 0x00u};
	(void)Dcm_IsoTp_Send(reqid, p, 5u, 0x00u, 1u);
}

static void ph_reset(void)
{
	r.active = 0u;
	r.req_canid = 0u;
	r.total_len = 0u;
	r.idx = 0u;
	r.next_sn = 1u;
	r.deadline_ms = 0u;
}

static void ph_queue(uint32_t req_canid, const uint8_t *uds, uint16_t len)
{
	if (len > PARAMH_RX_MAX) { ph_reset(); return; }

	q_reqid = req_canid;
	q_len   = len;
	memcpy(q_uds, uds, len);
	q_pending = 1u;
}

static void ph_send_fc(uint32_t req_canid, uint8_t fs, uint8_t bs, uint8_t stmin)
{
	CAN_TxHeaderTypeDef th = {0};
	uint32_t mbx;
	uint8_t  fc[8] = {0};

	th.StdId = req_canid + DCM_RESP_ID_DELTA; /* ECU->tester */
	th.IDE   = CAN_ID_STD;
	th.RTR   = CAN_RTR_DATA;
	th.DLC   = 8u;

	fc[0] = (uint8_t)(0x30u | (fs & 0x0Fu));
	fc[1] = bs;
	fc[2] = stmin;

	HAL_StatusTypeDef st;
	do { st = HAL_CAN_AddTxMessage(&hcan, &th, fc, &mbx); } while (st != HAL_OK);
}

/* accept only RoutineControl 31 01 01 AA/AB */
static bool ph_is_paramh_routine(const uint8_t *uds, uint16_t len)
{
	if (len < 4u) return false;
	if (uds[0] != 0x31u) return false;
	if (uds[1] != 0x01u) return false;
	if (uds[2] != 0x01u) return false;
	if ((uds[3] != 0xAAu) && (uds[3] != 0xABu)) return false;
	return true;
}

bool ParamH_IsoTpRx_Feed(const CAN_RxHeaderTypeDef *rh, const uint8_t *d)
{
	if (rh->IDE != CAN_ID_STD) return false;

	/* handle timeout */
	if (r.active && (HAL_GetTick() > r.deadline_ms))
	{
		ph_reset();
	}

	uint8_t pci_type = (uint8_t)(d[0] & 0xF0u);

	/* Single Frame */
	if (pci_type == 0x00u)
	{
		uint8_t sf_len = (uint8_t)(d[0] & 0x0Fu);
		if (sf_len == 0u || sf_len > 7u) return false;

		uint8_t uds[7];
		memcpy(uds, &d[1], sf_len);

		if (!ph_is_paramh_routine(uds, sf_len)) return false;

		ph_queue(rh->StdId, uds, sf_len);
		return true;
	}

	/* First Frame */
	if (pci_type == 0x10u)
	{
		uint16_t total = (uint16_t)(((uint16_t)(d[0] & 0x0Fu) << 8) | d[1]);
		if (total < 8u || total > PARAMH_RX_MAX) return false;

		uint8_t first6[6];
		memcpy(first6, &d[2], 6u);

		if (!ph_is_paramh_routine(first6, 4u)) /* need at least SID..RID */
		{
			return false; /* let DCM see it */
		}

		/* start reassembly */
		r.active = 1u;
		r.req_canid = rh->StdId;
		r.total_len = total;
		r.idx = 0u;
		r.next_sn = 1u;
		r.deadline_ms = HAL_GetTick() + PARAMH_RX_TIMEOUT_MS;

		memcpy(&q_uds[0], first6, 6u);
		r.idx = 6u;

		/* send FlowControl: CTS, BS=0 (unlimited), STmin=0 */
		ph_send_fc(r.req_canid, 0x00u, 0x00u, 0x00u);

		return true;
	}

	/* Consecutive Frame */
	if (pci_type == 0x20u)
	{
		if (!r.active) return false;
		if (rh->StdId != r.req_canid) return false;

		uint8_t sn = (uint8_t)(d[0] & 0x0Fu);
		if (sn != (r.next_sn & 0x0Fu))
		{
			ph_reset();
			return true; /* consumed but invalid */
		}

		uint16_t remain = (uint16_t)(r.total_len - r.idx);
		uint8_t  take   = (remain >= 7u) ? 7u : (uint8_t)remain;

		memcpy(&q_uds[r.idx], &d[1], take);
		r.idx = (uint16_t)(r.idx + take);

		r.next_sn = (uint8_t)((r.next_sn + 1u) & 0x0Fu);
		r.deadline_ms = HAL_GetTick() + PARAMH_RX_TIMEOUT_MS;

		if (r.idx >= r.total_len)
		{
			ph_queue(r.req_canid, q_uds, r.total_len);
			ph_reset();
		}

		return true;
	}

	/* FlowControl frames belong to TX side (DCM), ignore here */
	return false;
}

bool ParamH_IsoTpRx_Pop(uint32_t *req_canid, uint8_t *uds, uint16_t *uds_len)
{
	if (!q_pending) return false;

	__disable_irq();
	q_pending = 0u;
	*req_canid = q_reqid;
	*uds_len   = q_len;
	memcpy(uds, q_uds, q_len);
	__enable_irq();

	return true;
}

