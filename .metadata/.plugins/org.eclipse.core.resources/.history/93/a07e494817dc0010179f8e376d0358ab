static bool f_ok(float x, float lo, float hi)
{
	return (isfinite(x) && (x >= lo) && (x <= hi));
}

static bool ParamH_Validate(const ParamH_Blob_t *b)
{
	/* header */
	if (b->hdr.magic[0] != PARAMH_MAGIC0 ||
			b->hdr.magic[1] != PARAMH_MAGIC1 ||
			b->hdr.magic[2] != PARAMH_MAGIC2 ||
			b->hdr.magic[3] != PARAMH_MAGIC3) return false;

	if (b->hdr.version != PARAMH_VERSION) return false;
	if (b->hdr.length  != (uint16_t)sizeof(ParamH_Params_t)) return false;

	const ParamH_Params_t *p = &b->p;

	/* hard checks (add more as needed) */
	if (p->SMon_P_UV_KL30 >= p->SMon_P_OV_KL30) return false;
	if (p->SMon_P_ADC_MaxValue != 4095u) return false;

	if (p->SMon_P_Varef < 2500u || p->SMon_P_Varef > 3600u) return false;
	if (p->SMon_P_Vrefint < 800u || p->SMon_P_Vrefint > 1600u) return false;

	if (p->SMon_P_NTC_PullUp_ResistorVale < 1000u || p->SMon_P_NTC_PullUp_ResistorVale > 100000u) return false;
	if (p->SMon_P_BetaConst < 2000u || p->SMon_P_BetaConst > 6000u) return false;

	if (!f_ok(p->SMon_P_VoltageDivider, 0.1f, 100.0f)) return false;
	if (!f_ok(p->SMon_P_AlphaFilter, 0.0f, 1.0f)) return false;
	if (!f_ok(p->SMon_P_ISenseNominal, 0.0f, 1000.0f)) return false;
	if (!f_ok(p->SMon_P_I2TRating, 0.0f, 1e9f)) return false;

	return true;
}

void ParamH_init(void)
{
	/* assumption: Nvm_ReadAll() already ran and loaded ParamH_RamMirror from flash via NVM block list */
	if (!ParamH_Validate(&ParamH_RamMirror))
	{
		ParamH_RamMirror = ParamH_Defaults;
		ParamH_ApplyToGlobals(&ParamH_RamMirror.p);
		Nvm_WriteBlock(NVM_BLOCKID_PARAMH, (uint32_t*)&ParamH_RamMirror);
	}
	else
	{
		ParamH_ApplyToGlobals(&ParamH_RamMirror.p);
	}
}

void ParamH_main(void)
{
	/* finish deferred write */
	if (job_active)
	{
		/* commit blob -> ram mirror -> globals -> NVM */
		memcpy(ParamH_GetRamMirrorBlob(), job_blob, ParamH_BlobSize);
		ParamH_ApplyToGlobals(ParamH_GetRamMirrorBlob());
		Nvm_WriteBlock(NVM_BLOCKID_PARAMH, (uint32_t*)ParamH_GetRamMirrorBlob());

		ParamH_SendPos(job_reqid, 0xABu);
		job_active = 0u;
	}

	uint32_t reqid;
	uint16_t len;
	uint8_t  uds[512];

	if (!ParamH_IsoTpRx_Pop(&reqid, uds, &len))
		return;

	/* only extended session */
	if (3u != Dcm_ActiveSessionState)
	{
		ParamH_SendNrc(reqid, 0x31u, 0x7Eu); /* subfunction not supported in active session */
		return;
	}

	/* must be 31 01 01 AA/AB */
	if (len < 4u || uds[0] != 0x31u || uds[1] != 0x01u || uds[2] != 0x01u)
	{
		ParamH_SendNrc(reqid, 0x31u, 0x13u); /* incorrect length/format */
		return;
	}

	uint8_t ridLo = uds[3];

	if (ridLo == 0xAAu)
	{
		/* build: 71 01 01 AA + blob (multi-frame response) */
		uint8_t out[4u + 512u];
		uint16_t outLen = (uint16_t)(4u + ParamH_BlobSize);

		out[0] = 0x71u; out[1] = 0x01u; out[2] = 0x01u; out[3] = 0xAAu;
		memcpy(&out[4], ParamH_GetRamMirrorBlob(), ParamH_BlobSize);

		(void)Dcm_IsoTp_Send(reqid, out, outLen, 0x55u, 1u);
		return;
	}

	if (ridLo == 0xABu)
	{
		/* write: expects blob after 31 01 01 AB */
		if (len != (uint16_t)(4u + ParamH_BlobSize))
		{
			ParamH_SendNrc(reqid, 0x31u, 0x13u);
			return;
		}

		if (!ParamH_ValidateBlob(&uds[4]))
		{
			ParamH_SendNrc(reqid, 0x31u, 0x31u); /* request out of range */
			return;
		}

		/* async: reply pending now, commit next tick */
		ParamH_SendNrc(reqid, 0x31u, 0x78u); /* response pending */

		job_reqid = reqid;
		memcpy(job_blob, &uds[4], ParamH_BlobSize);
		job_active = 1u;
		return;
	}

	ParamH_SendNrc(reqid, 0x31u, 0x12u); /* subfunction not supported */
}

bool ParamH_HandleRoutine_0101AA_Read(uint32_t req_canid)
{
	uint8_t payload[4u + sizeof(ParamH_Blob_t)];
	uint16_t idx = 0u;

	/* 0x71 response, routine status record follows */
	payload[idx++] = 0x71u;
	payload[idx++] = 0x01u; /* subfunction echo */
	payload[idx++] = 0x01u; /* routineId hi */
	payload[idx++] = 0xAAu; /* routineId lo */

	/* always send the RAM mirror (current effective values) */
	memcpy(&payload[idx], &ParamH_RamMirror, sizeof(ParamH_Blob_t));
	idx = (uint16_t)(idx + sizeof(ParamH_Blob_t));

	return Dcm_IsoTp_Send(req_canid, payload, idx, 0x55u, 1u);
}

bool ParamH_HandleRoutine_0101AB_Write(uint32_t req_canid, const uint8_t *uds, uint16_t uds_len)
{
	/* uds points to SID=0x31 ... (NO ISO-TP PCI bytes), len is full UDS payload length */

	/* minimal format check: 31 01 01 AB + blob */
	if (uds_len < 4u + sizeof(ParamH_Blob_t)) return false;
	if (uds[0] != 0x31u || uds[1] != 0x01u || uds[2] != 0x01u || uds[3] != 0xABu) return false;

	const ParamH_Blob_t *in = (const ParamH_Blob_t*)&uds[4];

	if (!ParamH_Validate(in)) return false;

	ParamH_RamMirror = *in;
	ParamH_ApplyToGlobals(&ParamH_RamMirror.p);

	Nvm_WriteBlock(NVM_BLOCKID_PARAMH, (uint32_t*)&ParamH_RamMirror);

	/* positive response */
	uint8_t resp[5] = {0x71u, 0x01u, 0x01u, 0xABu, 0x00u};
	return Dcm_IsoTp_Send(req_canid, resp, (uint16_t)sizeof(resp), 0x00u, 1u);
}
