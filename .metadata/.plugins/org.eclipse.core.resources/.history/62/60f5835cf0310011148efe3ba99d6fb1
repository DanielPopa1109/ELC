typedef enum
{
    SMON_BATT_STATE_UNKNOWN   = 0u,
    SMON_BATT_STATE_REST      = 1u,
    SMON_BATT_STATE_CHARGE    = 2u,
    SMON_BATT_STATE_DISCHARGE = 3u
} SMon_BattState_t;

typedef struct
{
    float Voltage_V;               /* T30 raw */
    float VoltageL1_V;             /* L1 raw */
    float VoltageFilt_V;           /* T30 filtered */
    float VoltageL1Filt_V;         /* L1 filtered */
    float DeltaL1T30_V;            /* L1 - T30 */
    float Current_A;               /* raw signed current, + discharge / - charge */
    float CurrentFilt_A;           /* filtered signed current */
    float NetCurrent_A;            /* debounced/usable current for estimation */
    float Power_W;                 /* + battery discharging, - battery charging */
    float ChargePower_W;           /* always positive */
    float DischargePower_W;        /* always positive */
    float Charge_Ah_Acc;
    float Discharge_Ah_Acc;
    float Net_Ah_Acc;              /* + into battery, - out of battery */
    float Charge_Wh_Acc;
    float Discharge_Wh_Acc;
    float Net_Wh_Acc;              /* + into battery, - out of battery */
    float SoC_Coulomb_pct;
    float SoC_OCV_pct;
    float SoC_Hybrid_pct;
    float SoH_pct;
    float AvailableCapacity_Ah;
    float NominalCapacity_Ah;
    float InternalResistance_Ohm;
    float OcvEst_V;
    float AvgChargeCurrent_A;      /* short-term EMA */
    float AvgDischargeCurrent_A;   /* short-term EMA */
    float RuntimeRemaining_h;
    float TimeToFull_h;
    uint8_t BatteryRested;
    uint8_t Charging;
    uint8_t Discharging;
    uint8_t WeakBattery;
    uint8_t DeepDischarge;
    uint8_t CrankingEvent;
    uint8_t ValidOcvCalibration;
    uint8_t ChargerPathActive;
    uint8_t State;                 /* SMon_BattState_t */
    uint8_t Confidence_pct;
} SMon_BatteryData_t;

#define SMON_BATT_DT_S                    (0.005f)
#define SMON_BATT_DT_H                    (SMON_BATT_DT_S / 3600.0f)
#define SMON_BATT_VALID_MIN_V             (6.0f)
#define SMON_BATT_VALID_MAX_V             (18.5f)
#define SMON_BATT_OCV_MIN_V               (9.0f)
#define SMON_BATT_OCV_MAX_V               (15.5f)

typedef uint32_t i2t_t;

#define I2T_SCALE_DIV          (1000u)   /* mA²·ms → A²·s */
#define I2T_DECAY_PERCENT      (85u)
#define I2T_DECAY_DIV          (100u)
#define I2T_MAX_LIMIT          (4000000000u) /* saturation */
/* calibrated in A²·s → convert once to internal unit */
#define I2T_RATING_INTERNAL \
    ((uint32_t)(SMon_P_I2TRating * 1000.0f))  /* A²s → mA²·ms */
#define SMON_REARM_DWELL_TICKS     (40u)   /* e.g. 50 ms */
#define SMON_REARM_VOLT_MARGIN     (200u)  /* mV above threshold */

