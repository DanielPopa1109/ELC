#include <stdint.h>

#define DEM_MAX_FF_DTC   20u
#define DEM_MAX_OBD_FF_DTC   8u

typedef struct __attribute__((packed))
{
	uint16_t occurrenceCnt;
	uint8_t  year;
	uint8_t  month;
	uint8_t  day;
	uint8_t  hour;
	uint8_t  minute;
	uint8_t  second;
	uint8_t  vehStatus;
	uint16_t L1VFB;
	uint16_t T30VFB;
	float    L1NTC;
	float    L1ISENSE;
	uint16_t padding2;
	uint8_t  padding1;
} Dem_FreezeFrame_t;

typedef struct __attribute__((packed))
{
	uint8_t OBD_AmbientTemperature ;
	uint8_t OBD_EngineCoolantTemperature ;
	uint8_t OBD_IntakeAirTemperature ;
	uint8_t OBD_EngineSpeed ;
	uint8_t OBD_EngineLoad ;
	uint8_t OBD_VehicleSpeed;
	uint8_t OBD_ObdReadiness;
	uint8_t padding1;
} Dem_ObdFreezeFrame_t;

extern Dem_FreezeFrame_t Dem_FF[DEM_MAX_FF_DTC];
extern Dem_ObdFreezeFrame_t Dem_OBD_FF[DEM_MAX_OBD_FF_DTC];

extern void Dem_SetDtc(uint32_t id, uint8_t stat);
extern void Dem_CaptureFreezeFrame(uint8_t idx);
extern uint8_t Dem_GetDtcStatus(uint32_t id);
extern uint8_t Dem_GetDtcStatus_Obd(uint32_t id);
extern void Dem_SetDtc_Obd(uint32_t id, uint8_t stat);
extern void Dem_CaptureFreezeFrame_Obd(uint8_t idx);
