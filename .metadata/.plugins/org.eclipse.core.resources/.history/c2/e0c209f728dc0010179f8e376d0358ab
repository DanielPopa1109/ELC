/* =====================================================================
 * Public functions
 * ===================================================================== */
void ParamH_init(void)
{
    ParamH_Header = PARAMH_HEADER_PATTERN;

    /* Try reading from NVM */
    Nvm_ReadAll();

    /* You could verify CRC or header here if stored */
    if (ParamH_Header != PARAMH_HEADER_PATTERN)
    {
        /* Defaults already in SMon globals */
    }

    ParamH_FillBlob();
}

void ParamH_main(void)
{
    if (ParamH_PendingRead)
    {
        ParamH_PendingRead = 0u;
        ParamH_FillBlob();

        Dcm_SendIsoTpResponse(0x71u, PARAMH_ROUTINE_READ_ID,
                              ParamH_RamMirrorBlob, sizeof(ParamH_RamMirrorBlob));
    }

    if (ParamH_PendingWrite)
    {
        ParamH_PendingWrite = 0u;
        ParamH_ApplyBlob(ParamH_RamMirrorBlob);
        Nvm_WriteAll();

        Dcm_SendIsoTpResponse(0x71u, PARAMH_ROUTINE_WRITE_ID, NULL, 0u);
    }
}

/* Called by DCM when new RoutineControl request arrives */
void ParamH_ProcessRoutine(uint8_t routineId, const uint8_t *data, uint16_t len)
{
    switch (routineId)
    {
        case PARAMH_ROUTINE_READ_ID:
        {
            ParamH_PendingRead = 1u;
            break;
        }

        case PARAMH_ROUTINE_WRITE_ID:
        {
            if ((data != NULL) && (len == sizeof(ParamH_RamMirrorBlob)))
            {
                if (ParamH_ValidateBlob(data))
                {
                    memcpy(ParamH_RamMirrorBlob, data, len);
                    ParamH_PendingWrite = 1u;
                }
                else
                {
                    Dcm_SendNegResponse(0x31u, 0x13u); /* Invalid data */
                }
            }
            else
            {
                Dcm_SendNegResponse(0x31u, 0x13u);
            }
            break;
        }

        default:
            Dcm_SendNegResponse(0x31u, 0x12u); /* Subfunction not supported */
            break;
    }
}

uint8_t *ParamH_GetRamMirrorBlob(void)
{
    return ParamH_RamMirrorBlob;
}

uint32_t ParamH_GetBlobSize(void)
{
    return sizeof(ParamH_RamMirrorBlob);
}
