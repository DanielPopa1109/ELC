static void SMon_I2TAccumulation(void)
{
	static float I2TCounter_Float;
	static float ISenseL1_Average_Float;
	static float ISenseL1_Avged_Float;
	static float DeltaAmper_Float;
	static uint8_t localI2tAvgCounter = 0u;

	if(1u == SMon_CmdStat)
	{
		if(SMon_P_I2TDebounceTime > localI2tAvgCounter)
		{
			localI2tAvgCounter++;
			ISenseL1_Average_Float += SMon_ISenseL1_Float;
		}
		else
		{
			ISenseL1_Avged_Float = ISenseL1_Average_Float / localI2tAvgCounter;
			localI2tAvgCounter = 0u;
			ISenseL1_Average_Float = 0u;
		}
	}
	else
	{
		/* Do nothing. */
	}

	if(SMon_P_ISenseNominal < ISenseL1_Avged_Float && 0u == SMon_I2TError && 1u == SMon_CmdStat)
	{
		DeltaAmper_Float = (ISenseL1_Avged_Float * ISenseL1_Avged_Float - SMon_P_ISenseNominal * SMon_P_ISenseNominal);
		I2TCounter_Float += DeltaAmper_Float;
		SMon_I2TCounter = (uint32_t)I2TCounter_Float;
	}
	else
	{
		if(SMon_MainCnt % SMon_P_I2TDebounceTime == 0u)
		{
			I2TCounter_Float = (I2TCounter_Float * SMon_P_I2TDecrementPercentFactor) / 100u;
			SMon_I2TCounter = (uint32_t)I2TCounter_Float;

			if(1u > I2TCounter_Float)
			{
				I2TCounter_Float = 0u;
				SMon_I2TCounter = (uint32_t)I2TCounter_Float;
			}
			else
			{
				/* Do nothing. */
			}
		}
		else
		{
			/* Do nothing. */
		}
	}

	if(I2TCounter_Float > SMon_P_I2TRating)
	{
		SMon_I2TError = 1u;
		Dem_SetDtc(0x53u, 0x2fu);
		Dem_SetDtc_Obd(0x0153u, 0xafu);
	}
	else if(0u == I2TCounter_Float && 1u == SMon_I2TError)
	{
		SMon_I2TError = 0u;
	}
	else
	{
		if(0x2fu == Dem_GetDtcStatus(0x53u))
		{
			Dem_SetDtc(0x53u, 0x2eu);
			Dem_SetDtc_Obd(0x0153u, 0xaeu);
		}
		else
		{
			/* Do nothing. */
		}
	}
}

static float SMon_Batt_AbsF(float x)
{
    return (x < 0.0f) ? (-x) : x;
}

static float SMon_Batt_ClampF(float x, float lo, float hi)
{
    if (x < lo)
    {
        return lo;
    }
    else if (x > hi)
    {
        return hi;
    }
    else
    {
        return x;
    }
}

static float SMon_Batt_RemoveZeroOffset(float i_raw)
{
    if (i_raw > SMon_P_ISenseZeroOffset_A)
    {
        return (i_raw - SMon_P_ISenseZeroOffset_A);
    }
    else if (i_raw < (-SMon_P_ISenseZeroOffset_A))
    {
        return (i_raw + SMon_P_ISenseZeroOffset_A);
    }
    else
    {
        return 0.0f;
    }
}

/* 12 V lead-acid OCV approximation at ~25 C, rested battery only. */
static float SMon_Batt_OcvToSoc(float ocv_v)
{
    static const float ocv_tbl[11] =
    {
        11.80f, 11.95f, 12.06f, 12.15f, 12.24f,
        12.32f, 12.40f, 12.48f, 12.56f, 12.64f, 12.73f
    };

    static const float soc_tbl[11] =
    {
        0.0f, 10.0f, 20.0f, 30.0f, 40.0f,
        50.0f, 60.0f, 70.0f, 80.0f, 90.0f, 100.0f
    };

    uint32_t i;

    if (ocv_v <= ocv_tbl[0u])
    {
        return soc_tbl[0u];
    }

    if (ocv_v >= ocv_tbl[10u])
    {
        return soc_tbl[10u];
    }

    for (i = 0u; i < 10u; i++)
    {
        if ((ocv_v >= ocv_tbl[i]) && (ocv_v < ocv_tbl[i + 1u]))
        {
            float x0 = ocv_tbl[i];
            float x1 = ocv_tbl[i + 1u];
            float y0 = soc_tbl[i];
            float y1 = soc_tbl[i + 1u];
            float ratio = (ocv_v - x0) / (x1 - x0);
            return y0 + (ratio * (y1 - y0));
        }
    }

    return 0.0f;
}

static float SMon_Batt_RintToSoh(float rint_ohm)
{
    float soh;

    if (rint_ohm <= SMon_P_BattNominalRint_Ohm)
    {
        soh = 100.0f;
    }
    else if (rint_ohm >= SMon_P_BattBadRint_Ohm)
    {
        soh = SMon_P_BattSoHMin_pct;
    }
    else
    {
        soh = 100.0f -
              ((rint_ohm - SMon_P_BattNominalRint_Ohm) *
              (100.0f - SMon_P_BattSoHMin_pct) /
              (SMon_P_BattBadRint_Ohm - SMon_P_BattNominalRint_Ohm));
    }

    return SMon_Batt_ClampF(soh, SMon_P_BattSoHMin_pct, SMon_P_BattSoHMax_pct);
}

static void SMon_Batt_UpdateChargePath(float delta_l1_t30_v)
{
    if (SMon_Battery.ChargerPathActive == 0u)
    {
        if (delta_l1_t30_v >= SMon_P_BattChargePathDeltaOn_V)
        {
            if (SMon_BattInt.chargePathOnTicks < SMon_P_WaitTimeOVUV)
            {
                SMon_BattInt.chargePathOnTicks++;
            }

            if (SMon_BattInt.chargePathOnTicks >= SMon_P_WaitTimeOVUV)
            {
                SMon_Battery.ChargerPathActive = 1u;
                SMon_BattInt.chargePathOffTicks = 0u;
            }
        }
        else
        {
            SMon_BattInt.chargePathOnTicks = 0u;
        }
    }
    else
    {
        if (delta_l1_t30_v <= SMon_P_BattChargePathDeltaOff_V)
        {
            if (SMon_BattInt.chargePathOffTicks < SMon_P_WaitTimeOVUV)
            {
                SMon_BattInt.chargePathOffTicks++;
            }

            if (SMon_BattInt.chargePathOffTicks >= SMon_P_WaitTimeOVUV)
            {
                SMon_Battery.ChargerPathActive = 0u;
                SMon_BattInt.chargePathOnTicks = 0u;
            }
        }
        else
        {
            SMon_BattInt.chargePathOffTicks = 0u;
        }
    }
}

static uint8_t SMon_Batt_GetRawState(float i_filt_a, uint8_t current_state)
{
    float enter_thr = SMon_P_BattCurrentDeadband_A;
    float exit_thr  = SMon_P_BattCurrentDeadband_A - SMon_P_BattCurrentHys_A;

    if (exit_thr < 0.0f)
    {
        exit_thr = 0.0f;
    }

    switch (current_state)
    {
        case SMON_BATT_STATE_CHARGE:
            if (i_filt_a <= (-exit_thr))
            {
                return SMON_BATT_STATE_CHARGE;
            }
            else if (i_filt_a >= enter_thr)
            {
                return SMON_BATT_STATE_DISCHARGE;
            }
            else
            {
                return SMON_BATT_STATE_REST;
            }

        case SMON_BATT_STATE_DISCHARGE:
            if (i_filt_a >= exit_thr)
            {
                return SMON_BATT_STATE_DISCHARGE;
            }
            else if (i_filt_a <= (-enter_thr))
            {
                return SMON_BATT_STATE_CHARGE;
            }
            else
            {
                return SMON_BATT_STATE_REST;
            }

        case SMON_BATT_STATE_REST:
        default:
            if (i_filt_a <= (-enter_thr))
            {
                return SMON_BATT_STATE_CHARGE;
            }
            else if (i_filt_a >= enter_thr)
            {
                return SMON_BATT_STATE_DISCHARGE;
            }
            else
            {
                return SMON_BATT_STATE_REST;
            }
    }
}

static void SMon_Batt_UpdateState(float i_filt_a)
{
    uint8_t rawState;

    rawState = SMon_Batt_GetRawState(i_filt_a, SMon_Battery.State);

    if (rawState != SMon_Battery.State)
    {
        if (rawState != SMon_BattInt.pendingState)
        {
            SMon_BattInt.pendingState = rawState;
            SMon_BattInt.pendingStateTicks = 1u;
        }
        else
        {
            if (SMon_BattInt.pendingStateTicks < SMon_P_WaitTimeOVUV)
            {
                SMon_BattInt.pendingStateTicks++;
            }

            if (SMon_BattInt.pendingStateTicks >= SMon_P_WaitTimeOVUV)
            {
                SMon_Battery.State = rawState;
                SMon_BattInt.pendingState = rawState;
                SMon_BattInt.pendingStateTicks = 0u;
            }
        }
    }
    else
    {
        SMon_BattInt.pendingState = rawState;
        SMon_BattInt.pendingStateTicks = 0u;
    }

    SMon_Battery.Charging    = (SMon_Battery.State == SMON_BATT_STATE_CHARGE) ? 1u : 0u;
    SMon_Battery.Discharging = (SMon_Battery.State == SMON_BATT_STATE_DISCHARGE) ? 1u : 0u;
}

static void SMon_Batt_UpdateChargeSupport(float delta_l1_t30_v)
{
    SMon_Battery.DeltaL1T30_V = delta_l1_t30_v;

    if (delta_l1_t30_v >= SMon_P_BattChargePathDeltaOn_V)
    {
        SMon_Battery.ChargerPathActive = 1u;
    }
    else if (delta_l1_t30_v <= SMon_P_BattChargePathDeltaOff_V)
    {
        if (SMon_Battery.State != SMON_BATT_STATE_CHARGE)
        {
            SMon_Battery.ChargerPathActive = 0u;
        }
    }
    else
    {
        /* keep previous state */
    }
}

static void SMon_Batt_UpdateRestState(void)
{
    if ((SMon_Battery.State == SMON_BATT_STATE_REST) &&
        (SMon_Battery.ChargerPathActive == 0u) &&
        (SMon_Batt_AbsF(SMon_Battery.CurrentFilt_A) <= SMon_P_BattRestCurrent_A))
    {
        if (SMon_BattInt.restTicks == 0u)
        {
            SMon_BattInt.restReferenceV = SMon_Battery.VoltageFilt_V;
            SMon_BattInt.restTicks = 1u;
        }
        else
        {
            if (SMon_Batt_AbsF(SMon_Battery.VoltageFilt_V - SMon_BattInt.restReferenceV) <= SMon_P_BattRestVoltDelta_V)
            {
                if (SMon_BattInt.restTicks < SMon_P_BattRestTimeTicks)
                {
                    SMon_BattInt.restTicks++;
                }
            }
            else
            {
                SMon_BattInt.restReferenceV = SMon_Battery.VoltageFilt_V;
                SMon_BattInt.restTicks = 1u;
            }
        }

        if (SMon_BattInt.restTicks >= SMon_P_BattRestTimeTicks)
        {
            SMon_Battery.BatteryRested = 1u;
        }
        else
        {
            SMon_Battery.BatteryRested = 0u;
        }
    }
    else
    {
        SMon_BattInt.restTicks = 0u;
        SMon_BattInt.restReferenceV = SMon_Battery.VoltageFilt_V;
        SMon_Battery.BatteryRested = 0u;
    }
}

static void SMon_Batt_UpdateRint(void)
{
    float currVAvg;
    float currIAvg;
    float dV;
    float dI;
    float rInst;

    SMon_BattInt.rintVSum += SMon_Battery.VoltageFilt_V;
    SMon_BattInt.rintISum += SMon_Battery.CurrentFilt_A;
    SMon_BattInt.rintCnt++;

    if (SMon_BattInt.rintCnt < SMon_P_WaitTimeOVUV)
    {
        return;
    }

    currVAvg = SMon_BattInt.rintVSum / (float)SMon_BattInt.rintCnt;
    currIAvg = SMon_BattInt.rintISum / (float)SMon_BattInt.rintCnt;

    if (SMon_BattInt.rintPrevValid != 0u)
    {
        dV = SMon_BattInt.rintPrevVAvg - currVAvg;
        dI = currIAvg - SMon_BattInt.rintPrevIAvg;

        if ((SMon_Batt_AbsF(dI) >= SMon_P_BattRintMinStep_A) &&
            (SMon_Batt_AbsF(currIAvg) >= SMon_P_BattRestCurrent_A) &&
            (SMon_Batt_AbsF(SMon_BattInt.rintPrevIAvg) >= SMon_P_BattRestCurrent_A))
        {
            rInst = SMon_Batt_AbsF(dV / dI);

            if ((rInst >= 0.001f) && (rInst <= 0.300f))
            {
                SMon_Battery.InternalResistance_Ohm +=
                    SMon_P_BattAlphaRint * (rInst - SMon_Battery.InternalResistance_Ohm);
            }
        }
    }

    SMon_BattInt.rintPrevVAvg = currVAvg;
    SMon_BattInt.rintPrevIAvg = currIAvg;
    SMon_BattInt.rintPrevValid = 1u;

    SMon_BattInt.rintVSum = 0.0f;
    SMon_BattInt.rintISum = 0.0f;
    SMon_BattInt.rintCnt = 0u;
}

static void SMon_BatteryData(void)
{
    float v_t30_v;
    float v_l1_v;
    float i_raw_a;
    float i_corr_a;
    float charge_a;
    float discharge_a;
    float usable_current_a;
    float ocv_est_v;
    float soc_ocv_pct;
    float conf;
    float low_load_blend;
    uint8_t voltagePlausible;

    v_t30_v = ((float)SMon_VfbT30) / 1000.0f;
    v_l1_v  = ((float)SMon_VfbL1) / 1000.0f;
    i_raw_a = SMon_ISenseL1_Float;
    i_corr_a = SMon_Batt_RemoveZeroOffset(i_raw_a);

    SMon_Battery.Voltage_V = v_t30_v;
    SMon_Battery.VoltageL1_V = v_l1_v;
    SMon_Battery.Current_A = i_raw_a;
    SMon_Battery.NominalCapacity_Ah = SMon_P_BattNominalCapacity_Ah;

    SMon_Battery.VoltageFilt_V += SMon_P_BattAlphaVolt * (v_t30_v - SMon_Battery.VoltageFilt_V);
    SMon_Battery.VoltageL1Filt_V += SMon_P_BattAlphaVolt * (v_l1_v - SMon_Battery.VoltageL1Filt_V);
    SMon_Battery.CurrentFilt_A += SMon_P_BattAlphaCurr * (i_corr_a - SMon_Battery.CurrentFilt_A);

    SMon_Battery.DeltaL1T30_V = SMon_Battery.VoltageL1Filt_V - SMon_Battery.VoltageFilt_V;

    SMon_Batt_UpdateChargePath(SMon_Battery.DeltaL1T30_V);
    SMon_Batt_UpdateRestState();
    SMon_Batt_UpdateChargeSupport(SMon_Battery.VoltageL1Filt_V - SMon_Battery.VoltageFilt_V);
    SMon_Batt_UpdateState(SMon_Battery.CurrentFilt_A);

    /* Use current Rint estimate to derive present usable capacity. */
    SMon_Battery.SoH_pct = SMon_Batt_RintToSoh(SMon_Battery.InternalResistance_Ohm);
    SMon_Battery.AvailableCapacity_Ah =
        SMon_Battery.NominalCapacity_Ah * (SMon_Battery.SoH_pct / 100.0f);

    if (SMon_Battery.AvailableCapacity_Ah < 1.0f)
    {
        SMon_Battery.AvailableCapacity_Ah = 1.0f;
    }

    usable_current_a = 0.0f;
    charge_a = 0.0f;
    discharge_a = 0.0f;

    if (SMon_Battery.State == SMON_BATT_STATE_CHARGE)
    {
        charge_a = -SMon_Battery.CurrentFilt_A;
        if (charge_a < 0.0f)
        {
            charge_a = 0.0f;
        }

        usable_current_a = -charge_a;

        SMon_Battery.Charge_Ah_Acc += charge_a * SMON_BATT_DT_H;
        SMon_Battery.Charge_Wh_Acc += (SMon_Battery.VoltageFilt_V * charge_a) * SMON_BATT_DT_H;
        SMon_Battery.Net_Ah_Acc += charge_a * SMON_BATT_DT_H;
        SMon_Battery.Net_Wh_Acc += (SMon_Battery.VoltageFilt_V * charge_a) * SMON_BATT_DT_H;

        SMon_Battery.AvgChargeCurrent_A +=
            SMon_P_BattAvgCurrentAlpha * (charge_a - SMon_Battery.AvgChargeCurrent_A);

        SMon_Battery.SoC_Coulomb_pct +=
            ((charge_a * SMon_P_BattChargeEfficiency) * SMON_BATT_DT_H * 100.0f) /
            SMon_Battery.AvailableCapacity_Ah;
    }
    else if (SMon_Battery.State == SMON_BATT_STATE_DISCHARGE)
    {
        discharge_a = SMon_Battery.CurrentFilt_A;
        if (discharge_a < 0.0f)
        {
            discharge_a = 0.0f;
        }

        usable_current_a = discharge_a;

        SMon_Battery.Discharge_Ah_Acc += discharge_a * SMON_BATT_DT_H;
        SMon_Battery.Discharge_Wh_Acc += (SMon_Battery.VoltageFilt_V * discharge_a) * SMON_BATT_DT_H;
        SMon_Battery.Net_Ah_Acc -= discharge_a * SMON_BATT_DT_H;
        SMon_Battery.Net_Wh_Acc -= (SMon_Battery.VoltageFilt_V * discharge_a) * SMON_BATT_DT_H;

        SMon_Battery.AvgDischargeCurrent_A +=
            SMon_P_BattAvgCurrentAlpha * (discharge_a - SMon_Battery.AvgDischargeCurrent_A);

        SMon_Battery.SoC_Coulomb_pct -=
            (discharge_a * SMON_BATT_DT_H * 100.0f) /
            SMon_Battery.AvailableCapacity_Ah;
    }
    else
    {
        usable_current_a = 0.0f;
    }

    SMon_Battery.SoC_Coulomb_pct =
        SMon_Batt_ClampF(SMon_Battery.SoC_Coulomb_pct,
                         SMon_P_BattMinSoC_pct,
                         SMon_P_BattMaxSoC_pct);

    SMon_Battery.NetCurrent_A = usable_current_a;
    SMon_Battery.Power_W = SMon_Battery.VoltageFilt_V * SMon_Battery.CurrentFilt_A;
    SMon_Battery.ChargePower_W = (charge_a > 0.0f) ? (SMon_Battery.VoltageFilt_V * charge_a) : 0.0f;
    SMon_Battery.DischargePower_W = (discharge_a > 0.0f) ? (SMon_Battery.VoltageFilt_V * discharge_a) : 0.0f;

    /* OCV estimate:
     * terminal voltage = OCV - I*R, with +I = discharge, -I = charge
     * => OCV ~= Vterminal + I*R
     */
    ocv_est_v = SMon_Battery.VoltageFilt_V +
                (SMon_Battery.CurrentFilt_A * SMon_Battery.InternalResistance_Ohm);

    ocv_est_v = SMon_Batt_ClampF(ocv_est_v, SMON_BATT_OCV_MIN_V, SMON_BATT_OCV_MAX_V);

    if (SMon_Battery.BatteryRested != 0u)
    {
        SMon_Battery.OcvEst_V = SMon_Battery.VoltageFilt_V;
        SMon_Battery.ValidOcvCalibration = 1u;
    }
    else
    {
        SMon_Battery.OcvEst_V = ocv_est_v;
        SMon_Battery.ValidOcvCalibration = 0u;
    }

    soc_ocv_pct = SMon_Batt_OcvToSoc(SMon_Battery.OcvEst_V);
    SMon_Battery.SoC_OCV_pct = soc_ocv_pct;

    /* Hard OCV correction only after real rest. */
    if (SMon_Battery.BatteryRested != 0u)
    {
        SMon_Battery.SoC_Coulomb_pct +=
            SMon_P_BattOcvCorrectionGain *
            (SMon_Battery.SoC_OCV_pct - SMon_Battery.SoC_Coulomb_pct);

        SMon_Battery.SoC_Coulomb_pct =
            SMon_Batt_ClampF(SMon_Battery.SoC_Coulomb_pct,
                             SMon_P_BattMinSoC_pct,
                             SMon_P_BattMaxSoC_pct);
    }

    /* Under low load, allow slight OCV blend. Under charge/discharge, trust CC much more. */
    low_load_blend = 0.0f;
    if ((SMon_Batt_AbsF(SMon_Battery.CurrentFilt_A) <= (SMon_P_BattCurrentDeadband_A + 0.5f)) &&
        (SMon_Battery.ChargerPathActive == 0u))
    {
        low_load_blend = SMon_P_BattHybridBlendLowLoad;
    }

    SMon_Battery.SoC_Hybrid_pct =
        ((1.0f - low_load_blend) * SMon_Battery.SoC_Coulomb_pct) +
        (low_load_blend * SMon_Battery.SoC_OCV_pct);

    SMon_Battery.SoC_Hybrid_pct =
        SMon_Batt_ClampF(SMon_Battery.SoC_Hybrid_pct,
                         SMon_P_BattMinSoC_pct,
                         SMon_P_BattMaxSoC_pct);

    /* Learn internal resistance only from 300 ms averaged plateaus. */
    SMon_Batt_UpdateRint();

    /* Recompute SoH/capacity after possible Rint update. */
    SMon_Battery.SoH_pct = SMon_Batt_RintToSoh(SMon_Battery.InternalResistance_Ohm);
    SMon_Battery.AvailableCapacity_Ah =
        SMon_Battery.NominalCapacity_Ah * (SMon_Battery.SoH_pct / 100.0f);

    if (SMon_Battery.AvailableCapacity_Ah < 1.0f)
    {
        SMon_Battery.AvailableCapacity_Ah = 1.0f;
    }

    if ((SMon_Battery.State == SMON_BATT_STATE_DISCHARGE) &&
        (SMon_Battery.AvgDischargeCurrent_A > 0.1f))
    {
        SMon_Battery.RuntimeRemaining_h =
            ((SMon_Battery.SoC_Hybrid_pct / 100.0f) * SMon_Battery.AvailableCapacity_Ah) /
            SMon_Battery.AvgDischargeCurrent_A;
    }
    else
    {
        SMon_Battery.RuntimeRemaining_h = 0.0f;
    }

    if ((SMon_Battery.State == SMON_BATT_STATE_CHARGE) &&
        (SMon_Battery.AvgChargeCurrent_A > 0.1f))
    {
        SMon_Battery.TimeToFull_h =
            (((100.0f - SMon_Battery.SoC_Hybrid_pct) / 100.0f) * SMon_Battery.AvailableCapacity_Ah) /
            (SMon_Battery.AvgChargeCurrent_A * SMon_P_BattChargeEfficiency);
    }
    else
    {
        SMon_Battery.TimeToFull_h = 0.0f;
    }

    SMon_Battery.WeakBattery =
        ((SMon_Battery.VoltageFilt_V <= SMon_P_BattWeakVolt_V) ||
         (SMon_Battery.SoC_Hybrid_pct <= 20.0f) ||
         (SMon_Battery.InternalResistance_Ohm >= (0.75f * SMon_P_BattBadRint_Ohm))) ? 1u : 0u;

    SMon_Battery.DeepDischarge =
        ((SMon_Battery.VoltageFilt_V <= SMon_P_BattDeepDischargeVolt_V) ||
         (SMon_Battery.SoC_Hybrid_pct <= 10.0f)) ? 1u : 0u;

    SMon_Battery.CrankingEvent =
        ((SMon_Battery.Voltage_V <= SMon_P_BattCrankVolt_V) &&
         (SMon_Batt_AbsF(SMon_Battery.CurrentFilt_A) > 5.0f)) ? 1u : 0u;

    conf = 35.0f;

    if (voltagePlausible != 0u)
    {
        conf += 10.0f;
    }

    if (SMon_Battery.ValidOcvCalibration != 0u)
    {
        conf += 20.0f;
    }

    if (SMon_Battery.BatteryRested != 0u)
    {
        conf += 10.0f;
    }

    if ((SMon_Battery.InternalResistance_Ohm >= 0.001f) &&
        (SMon_Battery.InternalResistance_Ohm <= 0.300f))
    {
        conf += 10.0f;
    }

    if (SMon_Battery.DeepDischarge != 0u)
    {
        conf -= 10.0f;
    }

    if (SMon_Battery.WeakBattery != 0u)
    {
        conf -= 5.0f;
    }

    if (SMon_Battery.CrankingEvent != 0u)
    {
        conf -= 5.0f;
    }

    SMon_Battery.Confidence_pct = (uint8_t)SMon_Batt_ClampF(conf, 0.0f, 100.0f);
}


static void SMon_ProcessShortToPlusTest(void)
{
	static uint32_t localDischargeTimer = 0u; // normal discharge counter
	static uint32_t localLowDisTimer = 0u; // very low voltage discharge counter
	static uint32_t localS2BCounter = 0u; // longer case discharge time counter

	if(1u != SMon_RequestPhysicalStatus)
	{
		if(0u == SMon_ShortToPlusTest)
		{
			SMon_ShortToPlusTest = 1u; // start short to plus test
		}
		else
		{
			/* Do nothing. */
		}
	}
	else if(1u == SMon_RequestPhysicalStatus)
	{
		SMon_ShortToPlusTest = 0u; // reset short to plus test status
		localDischargeTimer = 0u; // reset normal discharge counter
		localLowDisTimer = 0u; // reset very low voltage discharge counter
		localS2BCounter = 0u; // reset longer case discharge time counter
		SMon_S2BErrorStatus = 0u;
	}
	else
	{
		/* Do nothing. */
	}

	if(0u != SMon_ShortToPlusTest)
	{
		if(0u == localDischargeTimer) // "first call"
		{
			localDischargeTimer = SMon_MainCnt; // time-stamp
			localLowDisTimer = SMon_MainCnt; // time-stamp
			localS2BCounter = SMon_MainCnt; // time-stamp
		}
		else
		{
			switch(SMon_ShortToPlusTest) // short-to-plus test phases
			{

			case 1u: // 50% of voltage discharge time check

				if(SMon_P_DischargeTimeCycles <= (SMon_MainCnt - localDischargeTimer))
				{
					if(SMon_T30P50 <= SMon_VfbL1)
					{
						Dem_SetDtc(0x52, 0x2f);
						Dem_SetDtc_Obd(0x0152u, 0xafu);
						SMon_ShortToPlusTest = 2u; // go-to next phase
						SMon_S2BErrorStatus = 1u;
					}
					else
					{
						/* Do nothing. */
					}
				}
				else
				{
					if(SMon_T30P50 > SMon_VfbL1) // abort this test phase
					{
						SMon_ShortToPlusTest = 2u; // go-to next phase
						SMon_S2BErrorStatus = 0u;

						if(0x2f == Dem_GetDtcStatus(0x52u))
						{
							Dem_SetDtc(0x52, 0x2e);
							Dem_SetDtc_Obd(0x0152u, 0xaeu);
						}
						else
						{
							/* Do nothing. */
						}
					}
					else
					{
						/* Do nothing. */
					}
				}

				break;

			case 2u:

				if(SMon_P_LowDisTimeCyc <= (SMon_MainCnt - localLowDisTimer))
				{
					if((SMon_VfbT30 * 3 / 10) <= SMon_VfbL1)
					{
						Dem_SetDtc(0x5f, 0x2f);
						Dem_SetDtc_Obd(0x0152u, 0xafu);
						SMon_ShortToPlusTest = 3u; // go-to next phase
						SMon_S2BErrorStatus = 2u;
					}
					else
					{
						/* Do nothing. */
					}
				}
				else
				{
					if((SMon_VfbT30 * 3 / 10) > SMon_VfbL1) // abort this test phase
					{
						SMon_ShortToPlusTest = 3u; // go-to next phase
						SMon_S2BErrorStatus = 0u;

						if(0x2f == Dem_GetDtcStatus(0x5fu))
						{
							Dem_SetDtc(0x5f, 0x2e);
							Dem_SetDtc_Obd(0x0152u, 0xaeu);
						}
						else
						{
							/* Do nothing. */
						}
					}
					else
					{
						/* Do nothing. */
					}
				}

				break;

			case 3u:

				if(SMon_P_LongDischargeTimeCycles <= (SMon_MainCnt - localS2BCounter))
				{
					if(SMon_P_LowVoltage <= SMon_VfbL1)
					{
						Dem_SetDtc(0x60, 0x2f);
						Dem_SetDtc_Obd(0x0152u, 0xafu);
						SMon_S2BErrorStatus = 3u;
						SMon_ShortToPlusTest = 4u; // finish short to plus test
					}
					else
					{
						/* Do nothing. */
					}
				}
				else
				{
					if(SMon_P_LowVoltage > SMon_VfbL1) // abort this test phase
					{
						SMon_ShortToPlusTest = 4u; // finish short to plus test
						SMon_S2BErrorStatus = 0u;

						if(0x2f == Dem_GetDtcStatus(0x60u))
						{
							Dem_SetDtc(0x60, 0x2e);
							Dem_SetDtc_Obd(0x0152u, 0xaeu);
						}
						else
						{
							/* Do nothing. */
						}
					}
					else
					{
						/* Do nothing. */
					}
				}

				break;

			default: // do nothing

				break;

			}
		}
	}
	else
	{
		/* Do nothing. */
	}
}

static void SMon_ProcessLoadCurrentState(void)
{
	static uint8_t pSMon_CalculatedCommand = 0u;
	static uint8_t inhibitReactivation = 0u;
	uint8_t calculatedCommand;
	uint8_t anyFaultActive;
	uint8_t risingEdgeCmd;
	uint32_t thresh_on;
	uint32_t thresh_off;

	SMon_T30P50 = (SMon_VfbT30 * 5u) / 10u;
	thresh_on  = SMon_T30P50 + SMon_P_StatusVoltageL1Filter;
	thresh_off = (SMon_T30P50 > SMon_P_StatusVoltageL1Filter) ? (SMon_T30P50 - SMon_P_StatusVoltageL1Filter) : 0u;

	if ((SMon_L1ST == 0u) && (SMon_VfbL1 >= thresh_on))
	{
		SMon_L1ST = 1u;
	}
	else if ((SMon_L1ST == 1u) && (SMon_VfbL1 <= thresh_off))
	{
		SMon_L1ST = 0u;
	}
	else
	{
		/* no change */
	}

	if (Dcm_LoadStatus == 1u)
	{
		calculatedCommand = 1u;
	}
	else if (Dcm_LoadStatus == 0u)
	{
		calculatedCommand = 0u;
	}
	else if (SMon_CmdStat == 1u)
	{
		calculatedCommand = 1u;
	}
	else if (SMon_CmdStat == 0u)
	{
		calculatedCommand = 0u;
	}
	else if (EcuM_WUPLine == 1u)
	{
		calculatedCommand = 1u;
	}
	else if (SMon_ExternalChargerDetected == 1u)
	{
		calculatedCommand = 1u;
	}
	else
	{
		calculatedCommand = 0u;
	}

	SMon_CalculatedCommand = calculatedCommand;

	anyFaultActive =
			(SMon_CLS_Failure != 0u) ||
			(SMon_L1_UVStatus  != 0u) ||
			(SMon_NtcError     != 0u) ||
			(SMon_ECU_OV       != 0u) ||
			(SMon_ECU_UV       != 0u);

	/* Latch inhibit when ANY voltage fault appears */
	if ((SMon_L1_UVStatus == 1u) ||
			(SMon_ECU_OV      == 1u) ||
			(SMon_ECU_UV      == 1u))
	{
		inhibitReactivation = 1u;
	}
	else
	{
		/* no change */
	}

	/* Command rising edge detection */
	risingEdgeCmd =
			(pSMon_CalculatedCommand == 0u) &&
			(SMon_CalculatedCommand  == 1u);

	/* Clear inhibit ONLY on command rising edge */
	if (risingEdgeCmd != 0u)
	{
		inhibitReactivation = 0u;
	}
	else
	{
		/* no change */
	}

	if ((SMon_CalculatedCommand == 1u) &&
			(anyFaultActive == 0u) &&
			(inhibitReactivation == 0u))
	{
		SMon_RequestPhysicalStatus = 1u;
	}
	else
	{
		SMon_RequestPhysicalStatus = 0u;
	}

	pSMon_CalculatedCommand = SMon_CalculatedCommand;
}

static void SMon_ProcessEcuVoltageState(void)
{
	static uint32_t CounterUVKL30 = 0u; // UV Counter For De-Bounce
	static uint32_t CounterOVKL30 = 0u; // OV Counter For De-Bounce

	if(SMon_P_UV_KL30 <= SMon_VfbT30 && SMon_P_OV_KL30 >= SMon_VfbT30) // UV OV checks
	{
		CounterUVKL30 = 0u; // reset counters
		CounterOVKL30 = 0u; // reset counters
		SMon_ECU_UV = 0u;
		SMon_ECU_OV = 0u;
	}
	else
	{
		if(SMon_P_UV_KL30 > SMon_VfbT30) // under-voltage
		{
			if(0u == CounterUVKL30) // "first call"
			{
				CounterUVKL30 = SMon_MainCnt; // time-stamp
			}
			else
			{
				if(SMon_P_WaitTimeOVUV < (SMon_MainCnt - CounterUVKL30)) // de-bounce for UV
				{
					SMon_ECU_UV = 1u;
					Dem_SetDtc(0x50, 0x2f);
					Dem_SetDtc_Obd(0x0150u, 0xafu);
				}
				else
				{
					SMon_ECU_UV = 0u;
					if(0x2f == Dem_GetDtcStatus(0x50))
					{
						Dem_SetDtc(0x50, 0x2e);
						Dem_SetDtc_Obd(0x0150u, 0xaeu);
					}
					else
					{
						/* Do nothing. */
					}
				}
			}
		}
		else
		{
			CounterUVKL30 = 0u; // reset counter
		}

		if(SMon_P_OV_KL30 < SMon_VfbT30) // over-voltage
		{
			if(0u == CounterOVKL30) // "first call"
			{
				CounterOVKL30 = SMon_MainCnt; // time-stamp
			}
			else
			{
				if(SMon_P_WaitTimeOVUV < (SMon_MainCnt - CounterOVKL30)) // de-bounce for OV - 300ms
				{
					SMon_ECU_OV = 1u;
					Dem_SetDtc(0x51, 0x2f);
					Dem_SetDtc_Obd(0x0151u, 0xafu);
				}
				else
				{
					SMon_ECU_OV = 0u;

					if(0x2f == Dem_GetDtcStatus(0x51))
					{
						Dem_SetDtc(0x51, 0x2e);
						Dem_SetDtc_Obd(0x0151u, 0xaeu);
					}
					else
					{
						/* Do nothing. */
					}
				}
			}
		}
		else
		{
			CounterOVKL30 = 0u; // reset counter
		}
	}
}

static void SMon_ProcessLoadErrorStatus(void)
{
	static uint8_t pSMon_I2TError = 0u;
	static uint8_t pSMon_CLS_Failure = 0u;
	static uint8_t pSMon_CmdStat = 0u;
	static uint32_t localTimeStamp = 0u;
	static uint32_t localTimeStamp2 = 0u;
	static uint32_t localTimeStamp3 = 0u;
	static uint8_t pCanH_VehicleStatus = 0u;
	static uint32_t l1_uv_recovery_ts = 0u;

	if(1u == SMon_LockSupply)
	{
		if( ( ( ( 1u ) == ( pCanH_VehicleStatus ) ) ||
				( ( 2u ) == ( pCanH_VehicleStatus ) ) ||
				( ( 3u ) == ( pCanH_VehicleStatus ) ) ) &&
				( ( ( 4u ) == ( CanH_VehicleStatus ) ) ||
						( ( 6u ) == ( CanH_VehicleStatus ) ) ) )
		{
			SMon_LockSupply = 0u;
			SMon_RetryCnt = 0u;
		}
		else
		{
			/* Do nothing. */
		}
	}
	else
	{
		/* Do nothing. */
	}

	if(pCanH_VehicleStatus != CanH_VehicleStatus)
	{
		pCanH_VehicleStatus = CanH_VehicleStatus;
	}
	{
		/* Do nothing. */
	}

	if(SMon_P_NTCTemperatureMax < SMon_NTC_Temperature_L1)
	{
		if(0u == localTimeStamp3)
		{
			localTimeStamp3 = SMon_MainCnt;
		}
		else
		{
			if(SMon_P_WaitTimeOVUV < (SMon_MainCnt - localTimeStamp3))
			{
				SMon_RequestPhysicalStatus = 0u;
				SMon_NtcError = 1u;

				Dem_SetDtc(0x58u, 0x2f);
				Dem_SetDtc_Obd(0x0158u, 0xafu);

				localTimeStamp3 = 0;
			}
			else
			{
				/* Do nothing. */
			}
		}

	}
	else if(SMon_P_NTCTemperatureRelease > SMon_NTC_Temperature_L1)
	{
		if(SMon_P_WaitTimeOVUV < (SMon_MainCnt - localTimeStamp3))
		{
			SMon_NtcError = 0u;

			if(0x2f == Dem_GetDtcStatus(0x58u))
			{
				Dem_SetDtc(0x58u, 0x2e);
			}
			else
			{
				/* Do nothing. */
			}

			localTimeStamp3 = 0;
		}
		else
		{
			/* Do nothing. */
		}
	}
	else
	{
		/* Do nothing. */
	}

	if(SMon_P_ExternalChargerThreshold > SMon_ISenseL1_ExtChISense)
	{
		if(0u == localTimeStamp2)
		{
			localTimeStamp2 = SMon_MainCnt;
		}
		else
		{
			if(SMon_P_WaitTimeOVUV < (SMon_MainCnt - localTimeStamp2))
			{
				SMon_ExternalChargerDetected = 1u;
				SMon_RequestPhysicalStatus = 1u;

				Dem_SetDtc(0x59u, 0x2f);

				localTimeStamp2 = 0;
			}
			else
			{
				/* Do nothing. */
			}
		}
	}
	else if(SMon_ISenseL1_ExtChISense > -0.1f)
	{
		if(0u == localTimeStamp2)
		{
			localTimeStamp2 = SMon_MainCnt;
		}
		else
		{
			if(SMon_P_WaitTimeOVUV < (SMon_MainCnt - localTimeStamp2))
			{
				SMon_ExternalChargerDetected = 0u;

				if(0x2f == Dem_GetDtcStatus(0x59u))
				{
					Dem_SetDtc(0x59u, 0x2e);
				}
				else
				{
					/* Do nothing. */
				}

				localTimeStamp2 = 0;

			}
			else
			{
				/* Do nothing. */
			}
		}
	}
	else
	{
		/* Do nothing. */
	}

	if(1u == SMon_CLS_Failure)
	{
		if(0u == localTimeStamp)
		{
			localTimeStamp = SMon_MainCnt;
		}
		else
		{
			if(SMon_P_ClsFailureWaitTime < (SMon_MainCnt - localTimeStamp))
			{
				SMon_CLS_Failure = 0u;
				localTimeStamp = 0u;
			}
			else
			{
				/* Do nothing. */
			}
		}
	}
	else
	{
		/* Do nothing. */
	}

	if( ( 1u == SMon_ECU_OV || 1u == SMon_ECU_UV ) )
	{
		SMon_RequestPhysicalStatus = 0u;
	}
	else
	{
		/* Do nothing. */
	}

	if(1u == SMon_I2TError)
	{
		SMon_RequestPhysicalStatus = 0u;
	}
	else
	{
		/* Do nothing. */
	}

	if(1u == pSMon_CLS_Failure && 0u == SMon_CLS_Failure && 0u == SMon_LockSupply)
	{
		pSMon_CLS_Failure = SMon_CLS_Failure;
		SMon_RetryCnt++;
	}
	else
	{
		/* Do nothing. */
	}

	if(1u == pSMon_I2TError && 0u == SMon_I2TError && 0u == SMon_LockSupply)
	{
		pSMon_I2TError = SMon_I2TError;
		SMon_RetryCnt++;
	}
	else
	{
		/* Do nothing. */
	}

	if(SMon_P_Rtcntmax == SMon_RetryCnt)
	{
		SMon_LockSupply = 1u;
		Dem_SetDtc(0x54, 0x2f);
		Dem_SetDtc_Obd(0x0154u, 0xafu);
	}
	else
	{
		/* Do nothing. */
	}

	if(0u != SMon_LockSupply)
	{
		SMon_RequestPhysicalStatus = 0u;
	}
	else
	{
		/* Do nothing. */
	}

	if (SMon_L1_UVStatus == 1u)
	{
		/* Keep fault latched */
		SMon_RequestPhysicalStatus = 0u;

		/* Start recovery timer only when voltage is back OK */
		if (SMon_VfbL1 >= SMon_T30P50)
		{
			if (l1_uv_recovery_ts == 0u)
			{
				l1_uv_recovery_ts = SMon_MainCnt;
			}
			else
			{
				if (SMon_P_WaitTimeOVUV < (SMon_MainCnt - l1_uv_recovery_ts))
				{
					/* Valid recovery → clear fault */
					SMon_L1_UVStatus = 0u;
					SMon_CounterUVL1 = 0u;
					l1_uv_recovery_ts = 0u;

					if (0x2fu == Dem_GetDtcStatus(0x56u))
					{
						Dem_SetDtc(0x56u, 0x2eu);
						Dem_SetDtc_Obd(0x0156u, 0xaeu);
					}
					else
					{
						// do nothing.
					}
				}
				else
				{
					// do nothing.
				}
			}
		}
		else
		{
			/* Still faulty → reset recovery timer */
			l1_uv_recovery_ts = 0u;
		}
	}
	else
	{
		l1_uv_recovery_ts = 0u;
	}

	if(pSMon_CmdStat != SMon_CmdStat)
	{
		pSMon_CmdStat = SMon_CmdStat;
	}
	else
	{
		/* Do nothing. */
	}

	if(pSMon_I2TError != SMon_I2TError)
	{
		pSMon_I2TError = SMon_I2TError;
	}
	else
	{
		/* Do nothing. */
	}

	if(pSMon_CLS_Failure != SMon_CLS_Failure)
	{
		pSMon_CLS_Failure = SMon_CLS_Failure;
	}
	else
	{
		/* Do nothing. */
	}
}

static void SMon_LoadSwitchingDiagnosis(void)
{
	if(1u == SMon_CLSFlag) // CLS ongoing
	{
		if(SMon_P_CLSTime - 20u <= (SMon_MainCnt - SMon_CLSCheckVoltage_Timestamp))
		{
			if(SMon_P_UV_CLS <= SMon_VfbL1) // voltage is rising, no error
			{
				SMon_CLS_Failure = 0u;

				if(0x2f == Dem_GetDtcStatus(0x55))
				{
					Dem_SetDtc(0x55, 0x2e);
					Dem_SetDtc_Obd(0x0155u, 0xaeu);
				}
				else
				{
					/* Do nothing. */
				}
			}
			else
			{
				SMon_CLS_Failure = 1u;
				SMon_RequestPhysicalStatus = 0u;
				Dem_SetDtc(0x55, 0x2f);
				Dem_SetDtc_Obd(0x0155u, 0xafu);
			}
		}
		else
		{
			/* Do nothing. */
		}

		if(SMon_P_CLSTime - 14u <= (SMon_MainCnt - SMon_CLSCheckVoltage_Timestamp))
		{
			if((SMon_T30P50 - 1000u) <= SMon_VfbL1) // voltage is rising, no error
			{
				SMon_CLS_Failure = 0u;

				if(0x2f == Dem_GetDtcStatus(0x55))
				{
					Dem_SetDtc(0x55, 0x2e);
				}
				else
				{
					/* Do nothing. */
				}
			}
			else
			{
				SMon_CLS_Failure = 1u;
				SMon_RequestPhysicalStatus = 0u;
				Dem_SetDtc(0x55, 0x2f);
			}
		}
		else
		{
			/* Do nothing. */
		}
	}
	else if(2u == SMon_CLSFlag) // CLS is done
	{
		if(1u == SMon_SWState)
		{
			if(SMon_T30P50 <= SMon_VfbL1) // No UV on output
			{
				SMon_L1_UVStatus = 0u;
				SMon_CounterUVL1 = 0u; // reset counter
			}
			else
			{
				if(SMon_VfbL1 < SMon_T30P50)
				{
					if(0u == SMon_CounterUVL1) // "first call"
					{
						SMon_CounterUVL1 = SMon_MainCnt; // time-stamp
					}
					else
					{
						if(SMon_P_WaitTimeOVUV < (SMon_MainCnt - SMon_CounterUVL1)) // de-bounce for UV - 300ms
						{
							SMon_L1_UVStatus = 1u;
							SMon_RequestPhysicalStatus = 0u;
							Dem_SetDtc(0x56, 0x2f);
							Dem_SetDtc_Obd(0x0156u, 0xafu);
						}
						else
						{
							/* Do nothing. */
						}
					}
				}
				else
				{
					if(0x2f == Dem_GetDtcStatus(0x56))
					{
						Dem_SetDtc(0x56, 0x2e);
						Dem_SetDtc_Obd(0x0156u, 0xaeu);
					}
					else
					{
						/* Do nothing. */
					}
				}
			}
		}
		else
		{
			/* Do nothing. */
		}

	}
	else
	{
		/* Do nothing. */
	}
}

static void SMon_LoadSwitchingLogic(void)
{
	static uint8_t localCPCFlag = 0u; // CPC status flag - off / on
	static uint32_t localCLSCounter = 0u; // time to wait with CLS active before changing CPC flag states

	htim1.Instance->CCR1 = 514u; // switch on CPC
	localCPCFlag = 2u; // CPC finished

	if(1u == SMon_RequestPhysicalStatus)
	{
		if(2u == localCPCFlag) // CPC finished
		{
			if(0u == SMon_CLSFlag) // CLS off
			{
				if(0u == localCLSCounter) // "first call"
				{
					localCLSCounter = SMon_MainCnt; // time-stamp
					SMon_CLSCheckVoltage_Timestamp = SMon_MainCnt;
					SMon_CLSFlag = 1u; // CLS ongoing
					HAL_GPIO_WritePin(ENL1CLS_GPIO_Port, ENL1CLS_Pin, 1u); // switch on CLS circuit
				}
				else
				{
					/* Do nothing. */
				}
			}
			else if(1u == SMon_CLSFlag) // CLS ongoing
			{
				if(SMon_P_CLSTime <= (SMon_MainCnt - localCLSCounter)) // de-bounce time based on parameter
				{
					localCLSCounter = 0u; // reset counter
					SMon_CLSFlag = 2u; // CLS finished
					HAL_GPIO_WritePin(ENL1CLS_GPIO_Port, ENL1CLS_Pin, 0u); // switch off CLS circuit
				}
				else if(SMon_P_CLSTime - 1u <= (SMon_MainCnt - localCLSCounter))
				{
					HAL_GPIO_WritePin(ENL1_GPIO_Port, ENL1_Pin, 1u); // switch on L1 circuit
				}
				else
				{
					/* Do nothing. */
				}
			}
			else
			{
				/* Do nothing. */
			}
		}
		else
		{
			/* Do nothing. */
		}
	}
	else if(0u == SMon_RequestPhysicalStatus)
	{
		localCPCFlag = 0u; // reset flag
		SMon_CLSFlag = 0u; // reset flag
		SMon_CounterUVL1 = 0u; // reset counter
		localCLSCounter = 0u; // reset counter
		SMon_CLSCheckVoltage_Timestamp = 0u;
		HAL_GPIO_WritePin(ENL1CLS_GPIO_Port, ENL1CLS_Pin, 0u); // switch off CLS
		HAL_GPIO_WritePin(ENL1_GPIO_Port, ENL1_Pin, 0u); // switch off L1
	}
	else
	{
		/* Do nothing. */
	}
}

static void SMon_CalculateMinMaxAvg(void)
{
	if (SMon_Stats10s_Active == 0u)
	{
		SMon_Stats10s_Timer++;

		if (SMon_VfbT30 < SMon_10s_T30_Min)
		{
			SMon_10s_T30_Min = SMon_VfbT30;
		}
		else
		{
			/* Do nothing. */
		}

		if (SMon_VfbT30 > SMon_10s_T30_Max)
		{
			SMon_10s_T30_Max = SMon_VfbT30;
		}
		else
		{
			/* Do nothing. */
		}

		SMon_10s_T30_Sum += SMon_VfbT30;

		if (SMon_VfbL1 < SMon_10s_L1_Min)
		{
			SMon_10s_L1_Min = SMon_VfbL1;
		}
		else
		{
			/* Do nothing. */
		}

		if (SMon_VfbL1 > SMon_10s_L1_Max)
		{
			SMon_10s_L1_Max = SMon_VfbL1;
		}
		else
		{
			/* Do nothing. */
		}

		SMon_10s_L1_Sum += SMon_VfbL1;

		if (SMon_ISenseL1_Float < SMon_10s_L1I_Min)
		{
			SMon_10s_L1I_Min = SMon_ISenseL1_Float;
		}
		else
		{
			/* Do nothing. */
		}

		if (SMon_ISenseL1_Float > SMon_10s_L1I_Max)
		{
			SMon_10s_L1I_Max = SMon_ISenseL1_Float;
		}
		else
		{
			/* Do nothing. */
		}

		SMon_10s_L1I_Sum += SMon_ISenseL1_Float;
		SMon_10s_SampleCnt++;
		SMon_10s_T30_Avg = SMon_10s_T30_Sum / (float)SMon_10s_SampleCnt;
		SMon_10s_L1_Avg  = SMon_10s_L1_Sum  / (float)SMon_10s_SampleCnt;
		SMon_10s_L1I_Avg = SMon_10s_L1I_Sum / (float)SMon_10s_SampleCnt;

		if (SMon_Stats10s_Timer >= SMon_P_10sCycles)
		{
			SMon_Stats10s_Active = 1u;
		}
		else
		{
			/* Do nothing. */
		}
	}
	else
	{
		/* Do nothing. */
	}

	if (SMon_StatsSW_Active == 0u)
	{
		if(SMon_MainCnt % 12001u == 0u && 0u != SMon_MainCnt)
		{
			SMon_SW_T30_Min = 1e9f;
			SMon_SW_T30_Max = -1e9f;
			SMon_SW_L1_Min = 1e9f;
			SMon_SW_L1_Max = -1e9f;
			SMon_SW_L1I_Min = 1e9f;
			SMon_SW_L1I_Max = -1e9f;
			SMon_SW_T30_Sum = 0.0f;
			SMon_SW_L1_Sum  = 0.0f;
			SMon_SW_L1I_Sum = 0.0f;
			SMon_SW_SampleCnt = 0u;
		}
		else
		{
			/* Do nothing. */
		}

		if (SMon_VfbT30 < SMon_SW_T30_Min)
		{
			SMon_SW_T30_Min = SMon_VfbT30;
		}
		else
		{
			/* Do nothing. */
		}

		if (SMon_VfbT30 > SMon_SW_T30_Max)
		{
			SMon_SW_T30_Max = SMon_VfbT30;
		}
		else
		{
			/* Do nothing. */
		}

		SMon_SW_T30_Sum += SMon_VfbT30;

		if (SMon_VfbL1 < SMon_SW_L1_Min)
		{
			SMon_SW_L1_Min = SMon_VfbL1;
		}
		else
		{
			/* Do nothing. */
		}

		if (SMon_VfbL1 > SMon_SW_L1_Max)
		{
			SMon_SW_L1_Max = SMon_VfbL1;
		}
		else
		{
			/* Do nothing. */
		}

		SMon_SW_L1_Sum += SMon_VfbL1;

		if (SMon_ISenseL1_Float < SMon_SW_L1I_Min)
		{
			SMon_SW_L1I_Min = SMon_ISenseL1_Float;
		}
		else
		{
			/* Do nothing. */
		}

		if (SMon_ISenseL1_Float > SMon_SW_L1I_Max)
		{
			SMon_SW_L1I_Max = SMon_ISenseL1_Float;
		}
		else
		{
			/* Do nothing. */
		}

		SMon_SW_L1I_Sum += SMon_ISenseL1_Float;

		SMon_SW_SampleCnt++;

		SMon_SW_T30_Avg  = SMon_SW_T30_Sum / (float)SMon_SW_SampleCnt;
		SMon_SW_L1_Avg   = SMon_SW_L1_Sum  / (float)SMon_SW_SampleCnt;
		SMon_SW_L1I_Avg  = SMon_SW_L1I_Sum / (float)SMon_SW_SampleCnt;
	}
	else
	{
		/* Do nothing. */
	}

	if (SMon_SWState >= 2u)
	{
		SMon_StatsSW_Active = 1u;
	}
	else
	{
		SMon_StatsSW_Active = 0u;
	}

	if(SMon_MainCnt % 12000u == 0u  && 0u != SMon_MainCnt)
	{
		SMon_DataMinMaxAvg[0u] = SMon_10s_T30_Min;
		SMon_DataMinMaxAvg[1u] = SMon_10s_T30_Max;
		SMon_DataMinMaxAvg[2u] = SMon_10s_T30_Avg;
		SMon_DataMinMaxAvg[3u] = SMon_10s_L1_Min;
		SMon_DataMinMaxAvg[4u] = SMon_10s_L1_Max;
		SMon_DataMinMaxAvg[5u] = SMon_10s_L1_Avg;
		SMon_DataMinMaxAvg[6u] = SMon_10s_L1I_Min;
		SMon_DataMinMaxAvg[7u] = SMon_10s_L1I_Max;
		SMon_DataMinMaxAvg[8u] = SMon_10s_L1I_Avg;
		SMon_DataMinMaxAvg[9u] = SMon_SW_T30_Min;
		SMon_DataMinMaxAvg[10u] = SMon_SW_T30_Max;
		SMon_DataMinMaxAvg[11u] = SMon_SW_T30_Avg;
		SMon_DataMinMaxAvg[12u] = SMon_SW_L1_Min;
		SMon_DataMinMaxAvg[13u] = SMon_SW_L1_Max;
		SMon_DataMinMaxAvg[14u] = SMon_SW_L1_Avg;
		SMon_DataMinMaxAvg[15u] = SMon_SW_L1I_Min;
		SMon_DataMinMaxAvg[16u] = SMon_SW_L1I_Max;
		SMon_DataMinMaxAvg[17u] = SMon_SW_L1I_Avg;

		Nvm_WriteBlock(3u, &SMon_DataMinMaxAvg[0u]);
	}
	else
	{
		/* Do nothing. */
	}
}

static void SMon_LoadCurrentErrorState(void)
{
	SMon_ProcessLoadCurrentState();
	SMon_ProcessLoadErrorStatus();
	SMon_I2TAccumulation();
	SMon_ProcessShortToPlusTest();
}

static void SMon_LoadSwitchState(void)
{
	SMon_LoadSwitchingDiagnosis();
	SMon_LoadSwitchingLogic();
}

void SMon_main(void)
{
	SMon_ProcessEcuVoltageState();
	SMon_LoadCurrentErrorState();
	SMon_LoadSwitchState();
	SMon_BatteryData();

	if(400u <= SMon_MainCnt && 0u != SMon_MainCnt)
	{
		SMon_CalculateMinMaxAvg();
	}
	else
	{
		// do nothing.
	}

	SMon_MainCnt++;
}
