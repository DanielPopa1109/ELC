			arrtx[3u] = 0u;
			arrtx[3u] |= (uint8_t)(((dtc >> 24u) >> 2u) & 0x03u);  /* bits 0..1 */
			arrtx[3u] |= (uint8_t)((stat & 0x3Fu) << 2u);          /* bits 2..7 */

