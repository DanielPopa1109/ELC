		{
			Dem_DTC_Stat[aux_index] = stat;
			Nvm_WriteBlock(1u, &Dem_DTC_Stat[0u]);
			Dem_CaptureFreezeFrame(aux_index);
		}
		else
		{
			/* Do nothing. */
		}

		Dem_DTC_Stat[aux_index] = stat;

