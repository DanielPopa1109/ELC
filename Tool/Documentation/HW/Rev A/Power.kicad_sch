	)
	(text "R30-R34: five 10 ohm resistors in parallel between PRE_R and OUTPUT (2 ohm equivalent)."
		(exclude_from_sim no)
		(at 20 345 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left)
