(fp_text user "ESTIMATED - REPLACE" (at 0 0) (layer "F.SilkS") (effects (font (size 0.75 0.75)) ))
(pad "1" thru_hole circle (at -15 0) (size 10 10) (drill 4.3) (layers "*.Cu" "*.Mask") (solder_mask_margin .03) (zone_connect 2))
(pad "2" thru_hole circle (at 15 0) (size 10 10) (drill 4.3) (layers "*.Cu" "*.Mask") (solder_mask_margin .03) (zone_connect 2))
(pad "3" thru_hole circle (at -3.81 8) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (solder_mask_margin .03) (zone_connect 2))
(pad "4" thru_hole circle (at -1.27 8) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (solder_mask_margin .03) (zone_connect 2))
(pad "5" thru_hole circle (at 1.27 8) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (solder_mask_margin .03) (zone_connect 2))
(pad "6" thru_hole circle (at 3.81 8) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (solder_mask_margin .03) (zone_connect 2))
