(attr through_hole)
(fp_rect (start -20 -10) (end 20 10) (stroke (width .1) (type default)) (fill none) (layer "F.Fab"))
(fp_rect (start -20 -10) (end 20 10) (stroke (width .05) (type default)) (fill none) (layer "F.CrtYd"))
